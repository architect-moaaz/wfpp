          {
            "type": "table",
            "config": {
              "title": "All Contacts",
              "columns": [
                {
                  "field": "name",
                  "header": "Name",
                  "sortable": true,
                  "style": {
                    "fontWeight": "500",
                    "color": "#1a1a1a"
                  }
                },
                {
                  "field": "email",
                  "header": "Email",
                  "sortable": true,
                  "style": {
                    "color": "#666666"
                  }
                },
                {
                  "field": "phone",
                  "header": "Phone",
                  "sortable": false,
                  "style": {
                    "color": "#666666"
                  }
                },
                {
                  "field": "company",
                  "header": "Company",
                  "sortable": true,
                  "style": {
                    "color": "#666666"
                  }
                },
                {
                  "field": "actions",
                  "header": "Actions",
                  "sortable": false
                }
              ],
              "actions": [
                {
                  "label": "View",
                  "type": "view",
                  "style": {
                    "color": "#007bff",
                    "fontSize": "14px",
                    "fontWeight": "500"
                  }
                },
                {
                  "label": "Edit",
                  "type": "edit",
                  "style": {
                    "color": "#28a745",
                    "fontSize": "14px",
                    "fontWeight": "500"
                  }
                },
                {
                  "label": "Delete",
                  "type": "delete",
                  "style": {
                    "color": "#dc3545",
                    "fontSize": "14px",
                    "fontWeight": "500"
                  }
                }
              ],
              "pagination": true,
              "pageSize": 10,
              "style": {
                "backgroundColor": "#ffffff",
                "borderRadius": "8px",
                "border": "1px solid #e0e0e0",
                "padding": "24px"
              }
            },
            "dataBinding": "Contact.list"
          }
        ]
      }
    ],
    "navigation": {
      "onAction": {
        "delete": {
          "type": "openDialog",
          "target": "delete-confirmation-dialog-1767695386473-v6limw"
        },
        "add": {
          "type": "openForm",
          "target": "add-contact-form-1767695348711-l26cr3"
