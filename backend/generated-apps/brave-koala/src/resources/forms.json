        "h": 8,
        "minW": 12,
        "minH": 8
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "ticket-details",
          "title": "Ticket Details",
          "fieldIds": [
            "ticket-title",
