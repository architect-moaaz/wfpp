[
  {
    "id": "fulfillment-shipping-form",
    "name": "FulfillmentShippingForm",
    "steps": [],
    "title": "Process Order Fulfillment & Shipping",
    "config": {},
    "fields": [
      {
        "id": "order-id",
        "name": "orderId",
        "type": "text",
        "label": "Order ID",
        "required": true,
        "validation": {
          "message": "Please enter a valid order ID (e.g., ORD-12345)",
          "pattern": "^ORD-[0-9]{5,}$"
        },
        "placeholder": "ORD-12345",
        "defaultValue": null
      },
      {
        "id": "items-confirmed",
        "name": "itemsConfirmed",
        "type": "checkbox",
        "label": "All items picked and verified",
        "required": true,
        "validation": {
          "message": "You must confirm all items have been picked"
        },
        "placeholder": "",
        "defaultValue": false
      },
      {
        "id": "package-weight",
        "name": "packageWeight",
        "type": "number",
        "label": "Package Weight (kg)",
        "required": true,
        "validation": {
          "max": 1000,
          "min": 0.1,
          "message": "Weight must be between 0.1 and 1000 kg"
        },
        "placeholder": "2.5",
        "defaultValue": null
      },
      {
        "id": "shipping-provider",
        "name": "shippingProvider",
        "type": "select",
        "label": "Shipping Provider",
        "options": [
          "FedEx",
          "UPS",
          "DHL",
          "USPS",
          "Local Courier"
        ],
        "required": true,
        "placeholder": "Select shipping provider",
        "defaultValue": null
      },
      {
        "id": "tracking-number",
        "name": "trackingNumber",
        "type": "text",
        "label": "Tracking Number",
        "required": true,
        "validation": {
          "message": "Please enter a valid tracking number (10-30 alphanumeric characters)",
          "pattern": "^[A-Z0-9]{10,30}$"
        },
        "placeholder": "1Z999AA10123456784",
        "defaultValue": null
      },
      {
        "id": "estimated-delivery",
        "name": "estimatedDelivery",
        "type": "date",
        "label": "Estimated Delivery Date",
        "required": true,
        "validation": {
          "min": "today",
          "message": "Delivery date must be today or in the future"
        },
        "placeholder": "",
        "defaultValue": null
      },
      {
        "id": "shipping-notes",
        "name": "shippingNotes",
        "type": "textarea",
        "label": "Shipping Notes (Optional)",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Notes must not exceed 500 characters"
        },
        "placeholder": "Any special handling instructions or notes...",
        "defaultValue": null
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "order-section",
          "title": "Order Information",
          "fieldIds": [
            "order-id",
            "items-confirmed"
          ]
        },
        {
          "id": "package-section",
          "title": "Package Details",
          "fieldIds": [
            "package-weight"
          ]
        },
        {
          "id": "shipping-section",
          "title": "Shipping Information",
          "fieldIds": [
            "shipping-provider",
            "tracking-number",
            "estimated-delivery"
          ]
        },
        {
          "id": "notes-section",
          "title": "Additional Information",
          "fieldIds": [
            "shipping-notes"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {},
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {
      "mode": "onSubmit",
      "showErrors": true
    },
    "description": "Confirm picked items, enter shipping details, and initiate order shipment",
    "data_model_id": null
  },
  {
    "id": "order-approval-form",
    "name": "OrderApprovalForm",
    "steps": [],
    "title": "Order Approval Review",
    "config": {},
    "fields": [
      {
        "id": "order-id",
        "name": "orderId",
        "type": "text",
