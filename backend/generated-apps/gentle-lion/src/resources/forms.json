        "label": "Payment Status",
        "options": [
          "Verified - Paid in Full",
          "Verified - Partial Payment",
          "Pending Verification",
          "Payment Failed"
        ],
        "required": true,
        "placeholder": "Select payment status",
        "defaultValue": null
      },
      {
        "id": "inventory-status",
        "name": "inventoryStatus",
        "type": "select",
        "label": "Inventory Availability",
        "options": [
          "All Items Available",
          "Partial Stock Available",
          "Backordered Items",
          "Out of Stock"
        ],
        "required": true,
        "placeholder": "Select inventory status",
        "defaultValue": null
      },
      {
        "id": "approval-decision",
        "name": "approvalDecision",
        "type": "radio",
        "label": "Approval Decision",
        "options": [
          "Approve",
          "Reject",
          "Hold for Review"
        ],
        "required": true,
        "defaultValue": null
      },
      {
        "id": "special-handling",
        "name": "specialHandling",
        "type": "checkbox",
        "label": "Special Handling Required",
        "required": false,
        "defaultValue": false
      },
      {
        "id": "handling-instructions",
        "name": "handlingInstructions",
        "type": "textarea",
        "label": "Special Handling Instructions",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Instructions must not exceed 500 characters"
        },
        "placeholder": "Enter any special handling or shipping instructions...",
        "defaultValue": null
      },
      {
        "id": "approval-comments",
        "name": "approvalComments",
        "type": "textarea",
        "label": "Approval Comments",
        "required": true,
        "validation": {
          "max": 1000,
          "min": 10,
          "message": "Comments must be between 10 and 1000 characters"
        },
        "placeholder": "Enter comments or reasons for your decision...",
        "defaultValue": null
      }
    ],
    "layout": {
      "type": "single-column",
      "sections": [
        {
          "id": "order-info",
          "title": "Order Information",
          "fieldIds": [
            "order-id"
          ]
        },
        {
          "id": "verification-status",
          "title": "Verification Status",
          "fieldIds": [
            "payment-status",
            "inventory-status"
          ]
        },
        {
          "id": "approval-section",
          "title": "Approval Decision",
          "fieldIds": [
            "approval-decision",
            "special-handling",
            "handling-instructions",
            "approval-comments"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {},
    "formType": null,
    "metadata": {},
    "gridLayout": [],
