        "inputPadding": "10px 12px"
      },
      "components": {
        "input": {
          "height": "42px",
          "borderWidth": "1px",
          "borderRadius": "4px"
        },
        "button": {
          "primary": {
            "color": "#ffffff",
            "padding": "12px 24px",
            "background": "#007bff"
          }
        }
      },
      "typography": {
        "fontSize": {
          "input": "16px",
          "label": "14px"
        },
        "fontFamily": "Arial, sans-serif",
        "fontWeight": {
          "input": "400",
          "label": "600"
        }
      }
    },
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {
      "mode": "onBlur",
      "showErrors": true
    },
    "description": "Select products and specify delivery details to complete your order",
    "data_model_id": null
