  {
    "id": "order-submission-form",
    "name": "OrderSubmissionForm",
    "steps": [],
    "title": "Submit New Order",
    "config": {},
    "fields": [
      {
        "id": "product-selection",
        "name": "productId",
        "type": "select",
        "label": "Product",
        "options": [
          "Loading products...",
          "Product A - In Stock",
          "Product B - In Stock",
          "Product C - Low Stock"
        ],
        "required": true,
        "validation": {
          "message": "Please select a product from inventory"
        },
        "placeholder": "Select a product",
        "defaultValue": null
      },
      {
        "id": "quantity",
        "name": "quantity",
        "type": "number",
        "label": "Quantity",
        "required": true,
        "validation": {
          "max": 999,
          "min": 1,
          "message": "Quantity must be between 1 and 999"
        },
        "placeholder": "Enter quantity",
        "defaultValue": 1
      },
      {
        "id": "customer-name",
        "name": "customerName",
        "type": "text",
        "label": "Customer Name",
        "required": true,
        "validation": {
          "message": "Please enter a valid name (2-50 characters)",
          "pattern": "^[a-zA-Z\\s]{2,50}$"
        },
        "placeholder": "Enter full name",
        "defaultValue": null
      },
      {
        "id": "shipping-address",
        "name": "shippingAddress",
        "type": "textarea",
        "label": "Shipping Address",
        "required": true,
        "validation": {
          "max": 200,
          "min": 10,
          "message": "Address must be between 10 and 200 characters"
        },
        "placeholder": "Enter complete delivery address",
        "defaultValue": null
      },
      {
        "id": "delivery-priority",
        "name": "deliveryPriority",
        "type": "select",
        "label": "Delivery Priority",
        "options": [
          "Standard (5-7 business days)",
          "Express (2-3 business days)",
          "Overnight (1 business day)"
        ],
        "required": true,
        "validation": {
          "message": "Please select a delivery option"
        },
        "placeholder": "Select shipping speed",
        "defaultValue": "Standard (5-7 business days)"
      },
      {
        "id": "contact-email",
        "name": "contactEmail",
        "type": "email",
        "label": "Contact Email",
        "required": true,
        "validation": {
          "message": "Please enter a valid email address",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "placeholder": "email@example.com",
        "defaultValue": null
      },
      {
        "id": "special-instructions",
        "name": "specialInstructions",
        "type": "textarea",
        "label": "Special Instructions",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Instructions cannot exceed 500 characters"
        },
        "placeholder": "Any special handling or delivery instructions (optional)",
        "defaultValue": null
      },
      {
        "id": "terms-agreement",
        "name": "termsAgreement",
        "type": "checkbox",
        "label": "I agree to the terms and conditions and confirm order details are accurate",
        "required": true,
        "validation": {
          "message": "You must agree to the terms to submit the order"
        },
        "placeholder": "",
        "defaultValue": false
      }
    ],
    "layout": {
      "type": "single-column",
      "sections": [
        {
          "id": "product-section",
          "title": "Product Selection",
          "fieldIds": [
            "product-selection",
            "quantity"
          ]
        },
        {
          "id": "customer-section",
          "title": "Customer & Shipping Information",
          "fieldIds": [
            "customer-name",
            "contact-email",
            "shipping-address",
            "delivery-priority"
          ]
        },
        {
          "id": "additional-section",
          "title": "Additional Details",
          "fieldIds": [
            "special-instructions",
            "terms-agreement"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {
      "colors": {
        "text": "#333333",
        "border": "#cccccc",
        "primary": "#007bff",
        "secondary": "#6c757d",
        "background": "#ffffff"
      },
      "spacing": {
        "fieldGap": "16px",
