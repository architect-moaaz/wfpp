      },
      "components": {
        "input": {
          "height": "42px",
          "borderWidth": "1px",
          "borderRadius": "6px"
        },
        "button": {
          "primary": {
            "color": "#ffffff",
            "padding": "10px 24px",
            "background": "#2563eb"
          }
        }
      },
      "typography": {
        "fontSize": {
          "input": "16px",
          "label": "14px"
        },
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontWeight": {
          "input": "400",
          "label": "500"
        }
      }
