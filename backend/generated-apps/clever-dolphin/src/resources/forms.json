      {
        "id": "last-name",
        "name": "lastName",
        "type": "text",
        "label": "Last Name",
        "placeholder": "Enter last name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "pattern": "^[a-zA-Z\\s'-]+$",
          "message": "Please enter a valid last name"
        },
        "defaultValue": null
      },
      {
        "id": "email",
        "name": "email",
        "type": "email",
        "label": "Email Address",
        "placeholder": "contact@example.com",
        "required": true,
        "validation": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "message": "Please enter a valid email address"
        },
        "defaultValue": null
      },
      {
        "id": "phone",
        "name": "phone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "+1 (555) 123-4567",
        "required": false,
        "validation": {
          "pattern": "^[+]?[(]?[0-9]{1,4}[)]?[-\\s\\.]?[(]?[0-9]{1,4}[)]?[-\\s\\.]?[0-9]{1,9}$",
