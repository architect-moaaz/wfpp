[
  {
    "id": "bookregistrationform-1764401625487-58f0hf",
    "name": "BookRegistrationForm",
    "steps": [],
    "title": "Register New Book",
    "config": {},
    "fields": [
      {
        "id": "field-isbn",
        "name": "isbn",
        "type": "text",
        "label": "ISBN",
        "required": true,
        "validation": {
          "message": "Please enter a valid ISBN-10 or ISBN-13 format",
          "pattern": "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]$"
        },
        "placeholder": "978-3-16-148410-0",
        "defaultValue": null
      },
      {
        "id": "field-title",
        "name": "title",
        "type": "text",
        "label": "Book Title",
        "required": true,
        "validation": {
          "max": 200,
          "min": 1,
          "message": "Title must be between 1 and 200 characters"
        },
        "placeholder": "Enter the book title",
        "defaultValue": null
      },
      {
        "id": "field-author",
        "name": "author",
        "type": "text",
        "label": "Author",
        "required": true,
        "validation": {
          "max": 100,
          "min": 2,
          "message": "Author name must be between 2 and 100 characters"
        },
        "placeholder": "Enter author name",
        "defaultValue": null
      },
      {
        "id": "field-category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "options": [
          "Fiction",
          "Non-Fiction",
          "Science",
          "History",
          "Biography",
          "Children",
          "Reference",
          "Technology"
        ],
        "required": true,
        "placeholder": "Select a category",
        "defaultValue": null
      },
      {
        "id": "field-publisher",
        "name": "publisher",
        "type": "text",
        "label": "Publisher",
        "required": false,
        "validation": {
          "max": 100,
          "message": "Publisher name cannot exceed 100 characters"
        },
        "placeholder": "Enter publisher name",
        "defaultValue": null
      },
      {
        "id": "field-publicationYear",
        "name": "publicationYear",
        "type": "number",
        "label": "Publication Year",
        "required": true,
        "validation": {
          "max": 2025,
          "min": 1000,
          "message": "Please enter a valid publication year between 1000 and 2025"
        },
        "placeholder": "YYYY",
        "defaultValue": null
      },
      {
        "id": "field-copies",
        "name": "copies",
        "type": "number",
        "label": "Number of Copies",
        "required": true,
        "validation": {
          "max": 100,
          "min": 1,
          "message": "Number of copies must be between 1 and 100"
        },
        "placeholder": "Enter quantity",
        "defaultValue": 1
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "section-identification",
          "title": "Book Identification",
          "fieldIds": [
            "field-isbn",
            "field-title",
            "field-author"
          ]
        },
        {
          "id": "section-details",
          "title": "Publication Details",
          "fieldIds": [
            "field-category",
            "field-publisher",
            "field-publicationYear",
            "field-copies"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {
      "colors": {
        "text": "#1e293b",
