[
  {
    "id": "workflow_1736629487234",
    "name": "Library Management System - Comprehensive Circulation Workflow",
    "edges": [],
    "nodes": [
      {
        "id": "node_start",
        "data": {
          "label": "Library Request Initiated",
          "formId": "bookcatalogform-1764404203645-gb0skk",
          "trigger": "Member or Librarian initiates library operation",
          "formName": "BookCatalogForm",
          "description": "Starting point for all library management operations"
        },
        "type": "startProcess",
        "position": {
          "x": 50,
          "y": 50
        }
      },
      {
        "id": "node_operation_type",
        "data": {
          "label": "Determine Operation Type",
          "condition": "processData.operationType",
          "description": "Route based on the type of library operation requested",
          "gatewayType": "exclusive"
        },
        "type": "decision",
        "position": {
          "x": 250,
          "y": 50
        }
      },
      {
        "id": "node_member_lookup",
        "data": {
          "label": "Validate Member Status",
          "script": "Lookup member ID and verify active membership status",
          "scriptType": "JavaScript",
          "description": "Verify member exists and has active library privileges"
        },
        "type": "scriptTask",
        "position": {
          "x": 150,
          "y": 200
        }
      },
      {
        "id": "node_member_validation",
        "data": {
          "label": "Member Status Check",
          "condition": "processData.memberStatus",
          "description": "Check if member has valid privileges and no outstanding issues",
          "gatewayType": "exclusive"
        },
        "type": "decision",
        "position": {
          "x": 150,
          "y": 300
        }
      },
      {
        "id": "node_new_member_reg",
        "data": {
          "label": "New Member Registration",
          "formId": "memberregistrationform-1764404224593-wvltj4",
          "dueDate": "1 day",
          "formName": "MemberRegistrationForm",
          "priority": "Medium",
          "taskName": "member_registration",
          "assignedTo": "librarian",
          "instructions": "Complete member registration with required documents and information"
        },
        "type": "userTask",
        "position": {
          "x": 450,
          "y": 200
        }
      },
      {
        "id": "node_parallel_checkout",
        "data": {
          "label": "Parallel Checkout Processing",
          "branches": "Book availability check, Member limit check, Due date calculation",
          "description": "Simultaneously process multiple checkout validations",
          "gatewayType": "parallel"
        },
        "type": "decision",
        "position": {
          "x": 50,
          "y": 450
        }
      },
      {
        "id": "node_book_availability",
        "data": {
          "label": "Check Book Availability",
          "script": "Query catalog to verify book is available and not reserved by others",
          "scriptType": "JavaScript",
          "description": "Validate requested book is currently available for checkout"
        },
        "type": "scriptTask",
        "position": {
          "x": -100,
          "y": 600
        }
      },
      {
        "id": "node_checkout_limit",
        "data": {
          "label": "Check Member Limits",
          "script": "Verify member hasn't exceeded checkout limits and has no overdue items",
          "scriptType": "JavaScript",
          "description": "Ensure member is within borrowing limits and good standing"
        },
        "type": "scriptTask",
        "position": {
          "x": 50,
          "y": 600
        }
      },
      {
        "id": "node_due_date_calc",
        "data": {
          "label": "Calculate Due Date",
          "script": "Calculate return date based on book type and member category",
          "scriptType": "JavaScript",
          "description": "Determine appropriate loan period for the book and member type"
        },
        "type": "scriptTask",
        "position": {
          "x": 200,
          "y": 600
        }
      },
      {
        "id": "node_checkout_validation",
        "data": {
          "label": "Checkout Authorization",
          "rules": [
            "book_available",
            "member_eligible",
            "limit_not_exceeded"
          ],
          "ruleType": "business_rules",
          "description": "Final validation before completing checkout transaction"
        },
        "type": "validation",
        "position": {
          "x": 50,
          "y": 750
        }
      },
      {
        "id": "node_checkout_decision",
        "data": {
          "label": "Checkout Approved?",
          "condition": "processData.checkoutApproved",
          "description": "Determine if checkout can proceed or needs alternative handling",
          "gatewayType": "exclusive"
        },
        "type": "decision",
        "position": {
          "x": 50,
          "y": 850
        }
      },
      {
        "id": "node_ai_recommendation",
        "data": {
          "label": "AI Book Recommendation",
          "model": "claude-sonnet-4-5-20250929",
          "prompt": "Based on member's reading history and current unavailable book request: ${processData.memberHistory}, ${processData.requestedBook}, suggest 3 alternative books with similar themes or by same author that are currently available.",
          "maxTokens": 500,
          "description": "Generate intelligent book recommendations when requested item is unavailable",
          "temperature": 0.8,
          "outputVariable": "bookRecommendations"
        },
        "type": "llmTask",
        "position": {
          "x": -150,
          "y": 950
        }
      },
      {
        "id": "node_reservation_process",
        "data": {
          "label": "Process Reservation",
          "formId": "bookcatalogform-1764404203645-gb0skk",
          "dueDate": "2 hours",
          "formName": "BookCatalogForm",
          "priority": "Low",
          "taskName": "book_reservation",
          "assignedTo": "librarian",
          "instructions": "Create reservation entry and notify member of estimated availability"
        },
        "type": "userTask",
        "position": {
          "x": -300,
          "y": 850
        }
      },
      {
        "id": "node_transaction_record",
        "data": {
          "input": "checkout_data",
          "label": "Record Transaction",
          "output": "transaction_log",
          "operation": "database_insert",
          "description": "Create official checkout record in library management system"
        },
        "type": "dataProcess",
        "position": {
          "x": 250,
          "y": 950
        }
      },
      {
        "id": "node_return_processing",
        "data": {
          "label": "Process Book Return",
          "script": "Update book status, calculate late fees if applicable, check book condition",
          "scriptType": "JavaScript",
          "description": "Handle book return including fee calculation and condition assessment"
        },
        "type": "scriptTask",
        "position": {
          "x": 500,
          "y": 450
        }
      },
      {
        "id": "node_late_fee_calc",
        "data": {
          "label": "AI Late Fee Assessment",
          "model": "claude-sonnet-4-5-20250929",
          "prompt": "Calculate late fees for returned book. Return date: ${processData.returnDate}, Due date: ${processData.dueDate}, Member type: ${processData.memberType}, Special circumstances: ${processData.notes}. Apply library policy and consider any valid reasons for delay.",
          "maxTokens": 300,
          "description": "Intelligently assess late fees considering library policies and special circumstances",
          "temperature": 0.3,
          "outputVariable": "lateFeeAssessment"
        },
        "type": "llmTask",
        "position": {
          "x": 500,
          "y": 600
        }
      },
      {
        "id": "node_overdue_notification",
        "data": {
          "label": "Send Overdue Notice",
          "channel": "Email",
          "template": "overdue_book_template",
          "recipient": "member",
          "description": "Notify member of overdue items and any applicable fees"
        },
        "type": "notification",
        "position": {
          "x": 650,
          "y": 750
        }
      },
      {
        "id": "node_timer_escalation",
        "data": {
          "label": "Escalation Timer",
          "duration": "PT168H",
          "timerType": "duration",
          "description": "Wait 7 days before escalating overdue items to collections"
        },
        "type": "timerEvent",
        "position": {
          "x": 800,
          "y": 600
        }
      },
      {
        "id": "node_collections_escalation",
        "data": {
          "label": "Collections Escalation",
          "formId": "bookcatalogform-1764404203645-gb0skk",
          "dueDate": "3 days",
          "formName": "BookCatalogForm",
          "priority": "High",
          "taskName": "collections_review",
          "assignedTo": "head_librarian",
          "instructions": "Review severely overdue items and initiate collections process if necessary"
        },
        "type": "userTask",
        "position": {
          "x": 950,
          "y": 750
        }
      },
      {
        "id": "node_completion_notice",
        "data": {
          "label": "Operation Completion Notice",
          "channel": "Email",
          "template": "operation_complete_template",
          "recipient": "member_and_staff",
          "description": "Confirm successful completion of library operation to all relevant parties"
        },
        "type": "notification",
        "position": {
          "x": 400,
          "y": 1100
        }
      },
      {
        "id": "node_error_handler",
        "data": {
          "label": "Error Resolution",
          "formId": "bookcatalogform-1764404203645-gb0skk",
          "dueDate": "4 hours",
          "formName": "BookCatalogForm",
          "priority": "High",
          "taskName": "error_handling",
          "assignedTo": "head_librarian",
          "instructions": "Review and resolve system error or policy exception requiring manual intervention"
        },
        "type": "userTask",
        "position": {
          "x": 700,
          "y": 400
        }
      },
      {
        "id": "node_end",
        "data": {
          "label": "Library Operation Complete",
          "result": "Library transaction successfully processed",
          "description": "All library management operations have been completed successfully"
        },
        "type": "endEvent",
        "position": {
          "x": 400,
          "y": 1200
        }
      }
    ],
