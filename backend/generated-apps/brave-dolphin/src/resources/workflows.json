      },
      {
        "id": "edge_5",
        "source": "node_member_lookup",
        "target": "node_member_validation"
      },
      {
        "id": "edge_6",
        "label": "Valid Member & Checkout",
        "source": "node_member_validation",
        "target": "node_parallel_checkout",
        "condition": "processData.memberStatus === 'active' && processData.operationType === 'checkout'"
      },
      {
        "id": "edge_7",
        "label": "Valid Member & Return",
        "source": "node_member_validation",
        "target": "node_return_processing",
        "condition": "processData.memberStatus === 'active' && processData.operationType === 'return'"
      },
      {
        "id": "edge_8",
        "label": "Invalid Member",
        "source": "node_member_validation",
        "target": "node_error_handler",
