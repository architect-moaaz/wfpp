        "source": "node_late_fee_calc",
        "target": "node_overdue_notification",
        "condition": "processData.lateFeeAssessment.amount > 0"
      },
      {
        "id": "edge_22",
        "label": "No Fees",
        "source": "node_late_fee_calc",
        "target": "node_completion_notice",
        "condition": "processData.lateFeeAssessment.amount === 0"
      },
      {
        "id": "edge_23",
        "label": "Severely Overdue",
        "source": "node_overdue_notification",
        "target": "node_timer_escalation",
        "condition": "processData.daysOverdue > 30"
      },
      {
        "id": "edge_24",
        "label": "Standard Overdue",
        "source": "node_overdue_notification",
        "target": "node_completion_notice",
        "condition": "processData.daysOverdue <= 30"
      },
