        "id": "edge_9",
        "data": {
          "isDefault": true
        },
        "label": "Default",
        "source": "node_parallel_checkout",
        "target": "node_book_availability",
        "isDefault": true
      },
      {
        "id": "edge_10",
        "source": "node_parallel_checkout",
        "target": "node_checkout_limit"
      },
      {
        "id": "edge_11",
        "source": "node_parallel_checkout",
        "target": "node_due_date_calc"
      },
      {
        "id": "edge_12",
        "source": "node_book_availability",
        "target": "node_checkout_validation"
      },
      {
        "id": "edge_13",
        "source": "node_checkout_limit",
        "target": "node_checkout_validation"
      },
      {
        "id": "edge_14",
        "source": "node_due_date_calc",
        "target": "node_checkout_validation"
      },
      {
        "id": "edge_15",
        "source": "node_checkout_validation",
        "target": "node_checkout_decision"
      },
