    "connections": [
      {
        "id": "edge_1",
        "source": "node_start",
        "target": "node_operation_type"
      },
      {
        "id": "edge_2",
        "label": "Checkout/Return",
        "source": "node_operation_type",
        "target": "node_member_lookup",
        "condition": "processData.operationType === 'checkout' || processData.operationType === 'return'"
      },
      {
        "id": "edge_3",
        "label": "New Registration",
        "source": "node_operation_type",
        "target": "node_new_member_reg",
        "condition": "processData.operationType === 'registration'"
      },
      {
        "id": "edge_4",
        "label": "Unknown Operation",
        "source": "node_operation_type",
        "target": "node_error_handler",
