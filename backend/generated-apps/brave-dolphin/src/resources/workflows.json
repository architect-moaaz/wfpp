        "id": "edge_16",
        "label": "Approved",
        "source": "node_checkout_decision",
        "target": "node_transaction_record",
        "condition": "processData.checkoutApproved === true"
      },
      {
        "id": "edge_17",
        "label": "Book Unavailable",
        "source": "node_checkout_decision",
        "target": "node_ai_recommendation",
        "condition": "processData.checkoutApproved === false && processData.reason === 'unavailable'"
      },
      {
        "id": "edge_18",
        "label": "Other Issues",
        "source": "node_checkout_decision",
        "target": "node_error_handler",
        "isDefault": true
      },
      {
        "id": "edge_19",
        "source": "node_ai_recommendation",
        "target": "node_reservation_process"
      },
      {
        "id": "edge_20",
        "source": "node_return_processing",
        "target": "node_late_fee_calc"
      },
