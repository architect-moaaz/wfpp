[
  {
    "id": "bookcatalogform-1764404203645-gb0skk",
    "name": "BookCatalogForm",
    "steps": [],
    "title": "Book Catalog Entry",
    "config": {},
    "fields": [
      {
        "id": "isbn",
        "name": "isbn",
        "type": "text",
        "label": "ISBN",
        "required": true,
        "validation": {
          "message": "Please enter a valid ISBN-10 or ISBN-13 format",
          "pattern": "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]$"
        },
        "placeholder": "978-3-16-148410-0",
        "defaultValue": null
      },
      {
        "id": "title",
        "name": "title",
        "type": "text",
        "label": "Book Title",
        "required": true,
        "validation": {
          "max": 255,
          "min": 1,
          "message": "Title must be between 1 and 255 characters"
        },
        "placeholder": "Enter the complete book title",
        "defaultValue": null
      },
      {
        "id": "author",
        "name": "author",
        "type": "text",
        "label": "Author(s)",
        "required": true,
        "validation": {
          "max": 200,
          "min": 2,
          "message": "Author name is required"
        },
        "placeholder": "Last Name, First Name",
        "defaultValue": null
      },
      {
        "id": "publisher",
        "name": "publisher",
        "type": "text",
        "label": "Publisher",
        "required": false,
        "validation": {
          "max": 150,
          "message": "Publisher name cannot exceed 150 characters"
        },
        "placeholder": "Publisher name",
        "defaultValue": null
      },
      {
        "id": "publicationYear",
        "name": "publicationYear",
        "type": "number",
        "label": "Publication Year",
        "required": true,
        "validation": {
          "max": 2025,
          "min": 1000,
          "message": "Enter a valid publication year between 1000 and 2025"
        },
        "placeholder": "YYYY",
        "defaultValue": null
      },
      {
        "id": "category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "options": [
          "Fiction",
          "Non-Fiction",
          "Science",
          "Technology",
          "History",
          "Biography",
          "Children",
          "Reference",
          "Academic",
          "Other"
        ],
        "required": true,
        "placeholder": "Select book category",
        "defaultValue": null
      },
      {
        "id": "copiesAvailable",
        "name": "copiesAvailable",
        "type": "number",
        "label": "Copies Available",
        "required": true,
        "validation": {
          "max": 999,
          "min": 0,
          "message": "Enter number of available copies (0-999)"
        },
        "placeholder": "0",
        "defaultValue": 1
      },
      {
        "id": "status",
        "name": "status",
        "type": "select",
        "label": "Inventory Status",
        "options": [
          "Available",
          "Checked Out",
          "Reserved",
          "In Processing",
          "Damaged",
          "Lost"
        ],
        "required": true,
        "placeholder": "Select status",
        "defaultValue": "Available"
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "bibliographic-info",
          "title": "Bibliographic Information",
          "fieldIds": [
            "isbn",
            "title",
            "author",
            "publisher",
            "publicationYear",
            "category"
          ]
        },
        {
          "id": "inventory-info",
          "title": "Inventory Details",
          "fieldIds": [
            "copiesAvailable",
            "status"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {
      "colors": {
        "text": "#1e293b",
        "border": "#e2e8f0",
        "primary": "#2563eb",
        "secondary": "#64748b",
        "background": "#ffffff"
      },
      "spacing": {
        "fieldGap": "16px",
        "sectionGap": "32px",
        "inputPadding": "10px 14px"
      },
      "components": {
        "input": {
          "height": "42px",
          "borderWidth": "1px",
          "borderRadius": "6px"
        },
        "button": {
          "primary": {
            "color": "#ffffff",
            "padding": "10px 24px",
            "background": "#2563eb"
          }
        }
      },
      "typography": {
        "fontSize": {
          "input": "15px",
          "label": "14px"
        },
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontWeight": {
          "input": "400",
          "label": "500"
        }
      }
    },
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {
      "mode": "onBlur",
      "showErrors": true
    },
    "description": "Add or update book records in the library catalog with bibliographic details and inventory information",
    "data_model_id": null
  },
  {
    "id": "memberregistrationform-1764404224593-wvltj4",
    "name": "MemberRegistrationForm",
    "steps": [],
    "title": "Library Member Registration",
    "config": {},
    "fields": [
      {
        "id": "full-name",
        "name": "fullName",
        "type": "text",
        "label": "Full Name",
        "required": true,
        "validation": {
          "max": 100,
          "min": 2,
          "message": "Please enter a valid name (letters, spaces, hyphens, and apostrophes only)",
          "pattern": "^[a-zA-Z\\s'-]+$"
        },
        "placeholder": "Enter your full name",
        "defaultValue": null
      },
      {
        "id": "email",
        "name": "email",
        "type": "email",
        "label": "Email Address",
        "required": true,
        "validation": {
          "message": "Please enter a valid email address",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "placeholder": "your.email@example.com",
        "defaultValue": null
      },
      {
        "id": "phone",
        "name": "phone",
        "type": "text",
        "label": "Phone Number",
        "required": true,
        "validation": {
          "min": 10,
          "message": "Please enter a valid phone number",
          "pattern": "^[\\d\\s()+-]+$"
        },
        "placeholder": "(555) 123-4567",
        "defaultValue": null
      },
      {
        "id": "date-of-birth",
        "name": "dateOfBirth",
        "type": "date",
        "label": "Date of Birth",
        "required": true,
        "validation": {
          "message": "You must be at least 5 years old to register"
        },
        "placeholder": "MM/DD/YYYY",
        "defaultValue": null
      },
      {
        "id": "address",
        "name": "address",
        "type": "textarea",
        "label": "Residential Address",
        "required": true,
        "validation": {
          "max": 300,
          "min": 10,
          "message": "Please enter a complete address"
        },
        "placeholder": "Enter your complete address including street, city, state, and ZIP code",
        "defaultValue": null
      },
      {
        "id": "membership-type",
        "name": "membershipType",
        "type": "select",
        "label": "Membership Type",
        "options": [
          "Adult (18+)",
          "Student (13-17)",
          "Child (5-12)",
          "Senior (65+)",
          "Family"
        ],
        "required": true,
        "placeholder": "Select membership type",
        "defaultValue": null
      },
      {
        "id": "id-type",
        "name": "idType",
        "type": "select",
        "label": "ID Document Type",
        "options": [
          "Driver's License",
          "State ID",
          "Passport",
          "Student ID",
          "Other Government ID"
        ],
        "required": true,
        "placeholder": "Select ID type",
        "defaultValue": null
      },
      {
        "id": "terms-agreement",
        "name": "termsAgreement",
        "type": "checkbox",
        "label": "I agree to the library terms and conditions, including responsibility for borrowed materials and adherence to library policies",
        "required": true,
        "validation": {
          "message": "You must agree to the terms and conditions to register"
        },
        "defaultValue": false
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "personal-info",
          "title": "Personal Information",
          "fieldIds": [
