[
  {
    "id": "rule_audit_log_input_validation",
    "name": "Audit Log Input Validation Rule",
    "description": "Validates required fields and data quality before starting audit logging process",
    "type": "validation",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "AuditLog.userId",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "AuditLog.userId",
          "value": "VALIDATION_ERROR",
          "message": "User ID is required to initiate audit logging"
        },
        {
          "type": "logMessage",
          "field": "AuditLog.status",
          "value": "FAILED",
          "message": "Audit log validation failed: Missing user identification"
        },
        {
          "type": "stopWorkflow",
          "field": "AuditLogWorkflow.status",
          "value": "TERMINATED",
          "message": "Workflow terminated due to validation failure"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "audit-log-workflow",
    "workflowId": "audit-log-workflow",
    "application_id": "app_1765080990809"
  },
  {
    "id": "rule_sensitive_data_check",
    "name": "Sensitive Data Access Decision Rule",
    "description": "Evaluates if audit log contains sensitive employee data requiring enhanced security measures",
    "type": "decision",
    "priority": 2,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "AuditLog.actionType",
          "operator": "in",
          "value": [
            "SALARY_VIEW",
            "PERSONAL_INFO_ACCESS",
            "MEDICAL_LEAVE_VIEW"
          ]
        },
        {
          "field": "Employee.role",
          "operator": "notEquals",
          "value": "HR_ADMIN"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "AuditLog.sensitiveDataFlag",
          "value": true,
          "message": "Sensitive data access detected"
        },
        {
          "type": "sendNotification",
          "field": "NotificationQueue.recipient",
          "value": "security@company.com",
          "message": "Alert: Sensitive data accessed by non-HR personnel - User: {{Employee.id}}, Action: {{AuditLog.actionType}}"
        },
        {
          "type": "updateData",
          "field": "AuditLog.securityLevel",
          "value": "HIGH",
          "message": "Elevated security level for sensitive data access"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "audit-log-workflow",
    "workflowId": "audit-log-workflow",
    "application_id": "app_1765080990809"
  }
]