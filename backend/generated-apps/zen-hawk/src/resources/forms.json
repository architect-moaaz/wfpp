  {
    "id": "leaverequestform-1765081469229-trergz",
    "name": "LeaveRequestForm",
    "title": "Submit Leave Request",
    "description": "Request time off with automatic balance validation and duration calculation",
    "fields": [
      {
        "id": "leave-type",
        "name": "leaveType",
        "type": "select",
        "label": "Leave Type",
        "placeholder": "Select leave type",
        "required": true,
        "options": [
          "Annual Leave",
          "Sick Leave",
          "Personal Leave",
          "Parental Leave",
          "Unpaid Leave",
          "Compassionate Leave"
        ],
        "defaultValue": null,
        "validation": {
          "message": "Please select a leave type"
        }
      },
      {
        "id": "available-balance",
        "name": "availableBalance",
        "type": "text",
        "label": "Available Balance",
        "placeholder": "Balance will display here",
        "required": false,
        "disabled": true,
        "defaultValue": null
      },
      {
        "id": "start-date",
        "name": "startDate",
        "type": "date",
        "label": "Start Date",
        "placeholder": "Select start date",
        "required": true,
        "validation": {
          "message": "Start date is required and cannot be a weekend or holiday"
        },
        "defaultValue": null
      },
      {
        "id": "end-date",
        "name": "endDate",
        "type": "date",
        "label": "End Date",
        "placeholder": "Select end date",
        "required": true,
        "validation": {
          "message": "End date must be after start date and cannot be a weekend or holiday"
        },
        "defaultValue": null
      },
      {
        "id": "duration",
        "name": "duration",
        "type": "number",
        "label": "Duration (Days)",
        "placeholder": "Auto-calculated",
        "required": false,
        "disabled": true,
        "defaultValue": null,
        "validation": {
          "min": 0.5,
          "message": "Duration must be at least 0.5 days"
        }
      },
      {
        "id": "half-day",
        "name": "halfDay",
        "type": "checkbox",
        "label": "Half Day Request",
        "required": false,
        "defaultValue": false
      },
      {
        "id": "reason",
