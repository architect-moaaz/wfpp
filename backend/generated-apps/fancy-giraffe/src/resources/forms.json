  {
    "id": "customerregistrationform-1764618061615-cyz3bz",
    "name": "CustomerRegistrationForm",
    "title": "New Customer Registration",
    "description": "Register a new customer in the CRM system with essential contact and company information.",
    "fields": [
      {
        "id": "field-fullname",
        "name": "fullName",
        "type": "text",
        "label": "Full Name",
        "placeholder": "Enter customer's full name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "pattern": "^[a-zA-Z\\s'-]+$",
          "message": "Please enter a valid name (letters, spaces, hyphens, and apostrophes only)"
        },
        "defaultValue": null
      },
      {
        "id": "field-email",
        "name": "email",
        "type": "email",
        "label": "Email Address",
        "placeholder": "customer@company.com",
        "required": true,
        "validation": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "message": "Please enter a valid email address"
        },
        "defaultValue": null
      },
      {
        "id": "field-companyname",
        "name": "companyName",
        "type": "text",
        "label": "Company Name",
        "placeholder": "Enter company name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 150,
          "message": "Company name must be between 2 and 150 characters"
        },
        "defaultValue": null
      },
      {
        "id": "field-phone",
        "name": "phone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "+1 (555) 123-4567",
        "required": true,
        "validation": {
          "pattern": "^[+]?[(]?[0-9]{1,4}[)]?[-\\s\\.]?[(]?[0-9]{1,4}[)]?[-\\s\\.]?[0-9]{1,9}$",
          "message": "Please enter a valid phone number"
        },
        "defaultValue": null
      },
      {
        "id": "field-industry",
        "name": "industry",
        "type": "select",
        "label": "Industry",
        "placeholder": "Select industry",
        "required": true,
        "options": [
          "Technology",
          "Healthcare",
          "Finance",
          "Manufacturing",
          "Retail",
          "Education",
          "Real Estate",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "field-companysize",
        "name": "companySize",
        "type": "select",
        "label": "Company Size",
        "placeholder": "Select company size",
        "required": true,
        "options": [
          "1-10 employees",
          "11-50 employees",
          "51-200 employees",
          "201-500 employees",
          "501-1000 employees",
          "1000+ employees"
        ],
        "defaultValue": null
      },
      {
        "id": "field-leadstage",
        "name": "leadStage",
        "type": "select",
        "label": "Lead Stage",
        "placeholder": "Select initial lead stage",
        "required": true,
        "options": [
          "New Lead",
          "Contacted",
          "Qualified",
