    "description": "Initial information collection for new employee onboarding process",
    "fields": [
      {
        "id": "firstName",
        "name": "firstName",
        "type": "text",
        "label": "First Name",
        "placeholder": "Enter first name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "pattern": "^[a-zA-Z\\s'-]+$",
          "message": "Please enter a valid first name"
        },
        "defaultValue": null
