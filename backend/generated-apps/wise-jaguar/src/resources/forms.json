      {
        "id": "phone",
        "name": "phone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "(555) 123-4567",
        "required": true,
        "validation": {
          "pattern": "^[\\d\\s()+-]+$",
          "message": "Please enter a valid phone number"
        },
        "defaultValue": null
