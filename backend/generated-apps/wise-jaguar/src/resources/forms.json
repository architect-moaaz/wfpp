  {
    "id": "documentuploadform-1764477783130-117ykn",
    "name": "DocumentUploadForm",
    "title": "Upload Required Documents",
    "description": "Securely upload your identification, tax forms, certifications, and other required documents to complete your onboarding process.",
    "fields": [
      {
        "id": "field-document-type",
        "name": "documentType",
        "type": "select",
        "label": "Document Type",
        "placeholder": "Select document type",
        "required": true,
        "validation": {
          "message": "Please select a document type"
        },
        "options": [
          "Government-Issued ID",
          "Tax Form (W-4/W-9)",
          "Direct Deposit Authorization",
          "Professional Certification",
          "Educational Diploma/Degree",
          "Background Check Authorization",
          "Emergency Contact Form",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "field-document-name",
        "name": "documentName",
        "type": "text",
        "label": "Document Name",
        "placeholder": "Enter a descriptive name for this document",
        "required": true,
        "validation": {
          "min": 3,
          "max": 100,
          "message": "Document name must be between 3 and 100 characters"
        },
        "defaultValue": null
      },
      {
        "id": "field-file-upload",
        "name": "fileUpload",
        "type": "file",
        "label": "Upload Document",
        "placeholder": "Choose file or drag and drop",
        "required": true,
        "validation": {
          "message": "Please upload a valid document (PDF, JPG, PNG, or DOCX, max 10MB)",
          "pattern": "\\.(pdf|jpg|jpeg|png|docx)$",
          "max": 10485760
        },
        "defaultValue": null
      },
      {
        "id": "field-expiration-date",
        "name": "expirationDate",
        "type": "date",
        "label": "Expiration Date (if applicable)",
        "placeholder": "Select expiration date",
        "required": false,
        "validation": {
          "message": "Expiration date must be in the future"
        },
        "defaultValue": null
      },
      {
        "id": "field-notes",
        "name": "notes",
        "type": "textarea",
        "label": "Additional Notes",
        "placeholder": "Add any relevant notes or comments about this document (optional)",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Notes must not exceed 500 characters"
        },
        "defaultValue": null
      },
      {
        "id": "field-confidentiality",
        "name": "confidentialityAcknowledgment",
        "type": "checkbox",
        "label": "I acknowledge that the information provided is accurate and will be stored securely in compliance with company privacy policies",
        "required": true,
        "validation": {
          "message": "You must acknowledge the confidentiality statement to proceed"
        },
        "defaultValue": false
      }
