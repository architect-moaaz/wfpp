  {
    "id": "productmanagementform-1764447924832-dxmwce",
    "name": "ProductManagementForm",
    "title": "Product Management",
    "description": "Create and manage product information, pricing, and inventory levels",
    "fields": [
      {
        "id": "product-name",
        "name": "productName",
        "type": "text",
        "label": "Product Name",
        "placeholder": "Enter product name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "message": "Product name must be between 2 and 100 characters"
        },
        "defaultValue": null
      },
      {
        "id": "product-sku",
        "name": "productSku",
        "type": "text",
        "label": "SKU",
        "placeholder": "e.g., PROD-12345",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9-]+$",
          "message": "SKU must contain only uppercase letters, numbers, and hyphens"
        },
        "defaultValue": null
      },
      {
        "id": "product-price",
        "name": "productPrice",
        "type": "number",
        "label": "Price ($)",
        "placeholder": "0.00",
        "required": true,
        "validation": {
          "min": 0.01,
          "max": 999999.99,
          "message": "Price must be between $0.01 and $999,999.99"
        },
        "defaultValue": null
      },
      {
        "id": "inventory-quantity",
        "name": "inventoryQuantity",
        "type": "number",
        "label": "Inventory Quantity",
        "placeholder": "0",
        "required": true,
        "validation": {
          "min": 0,
          "max": 999999,
          "message": "Quantity must be between 0 and 999,999"
        },
        "defaultValue": 0
      },
      {
        "id": "product-status",
        "name": "productStatus",
        "type": "select",
        "label": "Product Status",
        "placeholder": "Select availability status",
        "required": true,
        "options": [
          "Active",
          "Inactive",
          "Out of Stock",
          "Discontinued"
        ],
        "defaultValue": "Active"
      },
      {
        "id": "product-category",
        "name": "productCategory",
        "type": "select",
        "label": "Category",
        "placeholder": "Select product category",
        "required": true,
        "options": [
          "Electronics",
          "Clothing",
          "Home & Garden",
          "Sports & Outdoors",
          "Books",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "product-description",
        "name": "productDescription",
        "type": "textarea",
        "label": "Product Description",
        "placeholder": "Enter detailed product description",
        "required": false,
        "validation": {
          "max": 1000,
          "message": "Description must not exceed 1000 characters"
        },
        "defaultValue": null
      }
    ],
    "gridLayout": [
