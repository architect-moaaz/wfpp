  {
    "id": "paymentsubmissionform-1765340592649-jwdd7d",
    "name": "PaymentSubmissionForm",
    "title": "Submit Payment",
    "description": "Complete your parking ticket payment by providing your payment information below",
    "fields": [
      {
        "id": "ticketId",
        "name": "ticketId",
        "type": "text",
        "label": "Ticket ID",
        "placeholder": "Enter your ticket number (e.g., TKT-2024-001)",
        "required": true,
        "validation": {
          "pattern": "^TKT-\\d{4}-\\d{3}$",
          "message": "Please enter a valid ticket ID (format: TKT-YYYY-XXX)"
        },
        "defaultValue": null
      },
      {
        "id": "amount",
        "name": "amount",
        "type": "number",
        "label": "Payment Amount",
        "placeholder": "0.00",
        "required": true,
        "validation": {
          "min": 0.01,
          "max": 10000,
          "message": "Amount must be between $0.01 and $10,000"
        },
        "defaultValue": null
      },
      {
        "id": "payerName",
        "name": "payerName",
        "type": "text",
        "label": "Full Name",
        "placeholder": "Enter your full name as it appears on card",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "message": "Please enter your full name"
        },
        "defaultValue": null
      },
      {
        "id": "payerEmail",
        "name": "payerEmail",
        "type": "email",
        "label": "Email Address",
        "placeholder": "your.email@example.com",
        "required": true,
        "validation": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "message": "Please enter a valid email address"
        },
        "defaultValue": null
      },
      {
        "id": "payerPhone",
        "name": "payerPhone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "(555) 123-4567",
        "required": true,
        "validation": {
          "pattern": "^[\\d\\s\\(\\)\\-\\+]+$",
          "min": 10,
          "message": "Please enter a valid phone number"
        },
        "defaultValue": null
      },
      {
        "id": "paymentMethod",
        "name": "paymentMethod",
        "type": "select",
        "label": "Payment Method",
        "placeholder": "Select payment method",
        "required": true,
        "options": [
          "Credit Card",
          "Debit Card",
          "Bank Transfer",
          "Digital Wallet"
        ],
        "defaultValue": null
      },
      {
        "id": "cardNumber",
        "name": "cardNumber",
        "type": "text",
        "label": "Card Number",
        "placeholder": "1234 5678 9012 3456",
        "required": true,
        "validation": {
          "pattern": "^[\\d\\s]{13,19}$",
          "message": "Please enter a valid card number"
        },
        "defaultValue": null
      },
      {
        "id": "expiryDate",
        "name": "expiryDate",
        "type": "text",
        "label": "Expiry Date",
        "placeholder": "MM/YY",
        "required": true,
        "validation": {
          "pattern": "^(0[1-9]|1[0-2])\\/\\d{2}$",
          "message": "Please enter expiry date in MM/YY format"
        },
        "defaultValue": null
      },
      {
        "id": "cvv",
        "name": "cvv",
        "type": "text",
        "label": "CVV",
        "placeholder": "123",
        "required": true,
        "validation": {
          "pattern": "^\\d{3,4}$",
          "min": 3,
          "max": 4,
          "message": "Please enter a valid 3 or 4 digit CVV"
        },
        "defaultValue": null
      }
