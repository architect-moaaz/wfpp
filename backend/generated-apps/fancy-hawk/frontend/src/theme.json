{
  "name": "sophisticated-light-dashboard",
  "mode": "light",
  "industry": "general",
  "applicationType": "general",
  "colors": {
    "primary": "#3b82f6",
    "secondary": "#64748b",
    "accent": "#8b5cf6",
    "background": "#ffffff",
    "cardBackground": "#ffffff",
    "cardBorder": "#e2e8f0",
    "text": "#0f172a",
    "textSecondary": "#475569",
    "textMuted": "#94a3b8",
    "border": "#e2e8f0",
    "input": "#ffffff",
    "inputBorder": "#d1d5db",
    "focus": "#3b82f6",
    "error": "#ef4444",
    "success": "#10b981",
    "warning": "#f59e0b",
    "info": "#06b6d4"
  },
  "typography": {
    "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
    "headingFontFamily": "Inter, system-ui, -apple-system, sans-serif",
    "monoFontFamily": "JetBrains Mono, Consolas, Monaco, monospace",
    "baseFontSize": "14px",
    "headingWeight": "600",
    "bodyWeight": "400",
    "lineHeight": "1.5"
  },
  "spacing": {
    "unit": "4px",
    "pagePadding": "24px",
    "cardPadding": "20px",
    "sectionGap": "32px",
    "fieldGap": "16px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "0.125rem",
    "base": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "base": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "cardHover": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
  },
  "layout": {
    "type": "sidebar",
    "sidebarWidth": "256px",
    "sidebarPosition": "left",
    "sidebarCollapsible": true,
    "sidebarCollapsedWidth": "64px",
    "containerMaxWidth": "1400px",
    "contentPadding": "24px",
    "headerHeight": "64px",
    "emphasis": "visual-hierarchy",
    "gridColumns": 12,
    "defaultCardLayout": "grid",
    "recommendedComponents": [
      "Card",
      "Table",
      "Button",
      "Input",
      "Select",
      "Badge",
      "Avatar",
      "Tabs",
      "Dialog",
      "Sheet",
      "DropdownMenu"
    ],
    "pageTemplates": {
      "dashboard": {
        "sections": [
          "metrics",
          "charts",
          "recent-activity",
          "quick-actions"
        ],
        "columns": 12,
        "metricsPerRow": 4
      },
      "list": {
        "style": "table",
        "pagination": "numbered",
        "filtersPosition": "top"
      },
      "detail": {
        "layout": "two-column",
        "actionsPosition": "top"
      },
      "form": {
        "layout": "single-column",
        "labelPosition": "top",
        "submitPosition": "bottom"
      }
    }
  },
  "designRationale": "Given the limited context and sophisticated name 'fancy_hawk', I've designed a professional, adaptable dashboard theme using a clean blue color palette that conveys trust and reliability. The layout emphasizes visual hierarchy with a collapsible sidebar for navigation flexibility. The design uses modern typography (Inter) and subtle shadows for a polished feel. The theme is industry-agnostic but professional enough to work across various business applications, with component choices that support both data display and user interaction."
}