{
  "name": "friendly-light-dashboard",
  "mode": "light",
  "industry": "general",
  "applicationType": "general",
  "colors": {
    "primary": "#2563eb",
    "secondary": "#64748b",
    "accent": "#f59e0b",
    "background": "#ffffff",
    "cardBackground": "#ffffff",
    "cardBorder": "#e2e8f0",
    "text": "#0f172a",
    "textSecondary": "#475569",
    "textMuted": "#94a3b8",
    "border": "#e2e8f0",
    "input": "#ffffff",
    "inputBorder": "#d1d5db",
    "focus": "#3b82f6",
    "error": "#dc2626",
    "success": "#16a34a",
    "warning": "#d97706",
    "info": "#0ea5e9"
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "headingFontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "monoFontFamily": "'JetBrains Mono', Consolas, 'Monaco', 'Courier New', monospace",
    "baseFontSize": "14px",
    "headingWeight": "600",
    "bodyWeight": "400",
    "lineHeight": "1.5"
  },
  "spacing": {
    "unit": "4px",
    "pagePadding": "24px",
    "cardPadding": "20px",
    "sectionGap": "32px",
    "fieldGap": "16px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "0.125rem",
    "base": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "base": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "cardHover": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
  },
  "layout": {
    "type": "sidebar",
    "sidebarWidth": "240px",
    "sidebarPosition": "left",
    "sidebarCollapsible": true,
    "sidebarCollapsedWidth": "64px",
    "containerMaxWidth": "1280px",
    "contentPadding": "24px",
    "headerHeight": "64px",
    "emphasis": "visual-hierarchy",
    "gridColumns": 12,
    "defaultCardLayout": "grid",
    "recommendedComponents": [
      "card",
      "button",
      "input",
      "select",
      "table",
      "badge",
      "avatar",
      "dropdown-menu",
      "tabs",
      "progress",
      "alert"
    ],
    "pageTemplates": {
      "dashboard": {
        "sections": [
          "metrics",
          "charts",
          "recent-activity",
          "quick-actions"
        ],
        "columns": 12,
        "metricsPerRow": 4
      },
      "list": {
        "style": "table",
        "pagination": "numbered",
        "filtersPosition": "top"
      },
      "detail": {
        "layout": "single-column",
        "actionsPosition": "top"
      },
      "form": {
        "layout": "single-column",
        "labelPosition": "top",
        "submitPosition": "bottom"
      }
    }
  },
  "designRationale": "Given the minimal context and friendly app name 'kind-monkey', I've designed a general-purpose, approachable theme that can adapt to various use cases. The color palette uses trustworthy blues with warm amber accents to balance professionalism with friendliness. The layout emphasizes clean visual hierarchy with adequate whitespace, making it suitable for both data display and user interaction. The collapsible sidebar provides flexibility for different screen sizes while maintaining easy navigation. This foundation can be easily customized once the specific industry and use case become clearer."
}