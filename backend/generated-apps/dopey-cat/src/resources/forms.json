          {
            "label": "Texas",
            "value": "TX"
          },
          {
            "label": "Florida",
            "value": "FL"
          },
          {
            "label": "Other State",
            "value": "other"
          }
        ],
        "section": "vehicle_section",
        "required": true,
        "fieldName": "vehicle_state"
      },
      {
        "type": "text",
        "label": "Vehicle Make & Model",
        "section": "vehicle_section",
        "required": true,
        "fieldName": "vehicle_make_model",
