[
  {
    "id": "employeedocumentsubmissionform-1764959969702-a0u811",
    "name": "EmployeeDocumentSubmissionForm",
    "title": "Employee Document Submission",
    "description": "Submit your required onboarding documents to complete your employee profile",
    "fields": [
      {
        "id": "employee-id",
        "name": "employeeId",
        "type": "text",
        "label": "Employee ID",
        "placeholder": "Enter your assigned employee ID",
        "required": true,
        "validation": {
          "pattern": "^EMP[0-9]{6}$",
          "message": "Employee ID must be in format EMP followed by 6 digits"
        },
        "defaultValue": null
      },
      {
        "id": "full-name",
        "name": "fullName",
        "type": "text",
        "label": "Full Legal Name",
        "placeholder": "Enter your full name as per ID proof",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "message": "Full name must be between 2 and 100 characters"
        },
        "defaultValue": null
      },
      {
        "id": "id-proof",
        "name": "idProof",
        "type": "file",
        "label": "Government ID Proof",
        "placeholder": "Upload passport, driver's license, or national ID",
        "required": true,
        "validation": {
          "pattern": "\\.(pdf|jpg|jpeg|png)$",
          "message": "Only PDF, JPG, JPEG, or PNG files are allowed"
        },
        "defaultValue": null
      },
      {
        "id": "tax-form",
        "name": "taxForm",
        "type": "file",
        "label": "Tax Form (W-4/W-9)",
        "placeholder": "Upload completed tax withholding form",
        "required": true,
        "validation": {
          "pattern": "\\.(pdf)$",
          "message": "Only PDF files are allowed"
        },
        "defaultValue": null
      },
      {
        "id": "bank-account",
        "name": "bankAccount",
        "type": "text",
        "label": "Bank Account Number",
        "placeholder": "Enter account number for direct deposit",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{8,17}$",
          "message": "Bank account number must be 8-17 digits"
        },
        "defaultValue": null
      },
      {
        "id": "routing-number",
        "name": "routingNumber",
        "type": "text",
        "label": "Bank Routing Number",
        "placeholder": "Enter 9-digit routing number",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{9}$",
          "message": "Routing number must be exactly 9 digits"
        },
        "defaultValue": null
      },
      {
        "id": "emergency-contact",
        "name": "emergencyContact",
        "type": "text",
        "label": "Emergency Contact Name",
        "placeholder": "Enter emergency contact full name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "message": "Contact name must be between 2 and 100 characters"
        },
        "defaultValue": null
      },
      {
        "id": "emergency-phone",
        "name": "emergencyPhone",
        "type": "text",
        "label": "Emergency Contact Phone",
        "placeholder": "Enter phone number with area code",
        "required": true,
        "validation": {
          "pattern": "^[+]?[(]?[0-9]{3}[)]?[-\\s\\.]?[0-9]{3}[-\\s\\.]?[0-9]{4,6}$",
          "message": "Please enter a valid phone number"
        },
        "defaultValue": null
      }
    ],
