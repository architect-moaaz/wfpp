[
  {
    "id": "memberportal-1764475200000-m3mb3r",
    "name": "MemberPortal",
    "title": "My Library Account",
    "description": "Member portal for viewing account details, checked out books, fees, and searching/reserving books",
    "route": "/member-portal",
    "type": "dashboard",
    "platform": "both",
    "forms": [
      "booksearchreservationform-1764475132534-p6aqvi"
    ],
    "sections": [
      {
        "id": "header",
        "type": "header",
        "components": [
          {
            "type": "text",
            "config": {
              "text": "My Library Account",
              "variant": "h1",
              "align": "left",
              "color": "#1a1a1a",
              "fontSize": "32px",
              "fontWeight": "700",
              "margin": "0 0 8px 0"
