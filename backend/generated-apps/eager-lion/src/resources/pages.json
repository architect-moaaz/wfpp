          "route": "/transactions",
          "icon": "receipt"
        },
        {
          "label": "Reports",
          "route": "/reports",
          "icon": "chart"
        }
      ]
    },
    "layout": {
      "type": "dashboard",
      "responsive": true,
      "spacing": "normal",
      "maxWidth": "1400px",
      "padding": "24px",
      "backgroundColor": "#f8fafc"
    },
    "workflowId": "workflow_1734899573"
  }
