          },
          {
            "type": "text",
            "config": {
              "text": "Welcome back! Manage your books, reservations, and account details.",
              "variant": "body1",
              "align": "left",
              "color": "#666666",
              "fontSize": "16px",
              "fontWeight": "400"
            }
          }
        ]
      },
      {
        "id": "main",
        "type": "main",
        "components": [
          {
            "type": "card",
            "config": {
              "title": "Currently Checked Out",
              "backgroundColor": "#ffffff",
              "borderRadius": "12px",
              "padding": "24px",
              "shadow": "0 2px 8px rgba(0,0,0,0.08)",
              "border": "1px solid #e0e0e0"
            },
            "dataBinding": "Transaction.query",
            "components": [
              {
                "type": "table",
                "config": {
                  "columns": [
                    {
                      "field": "book.title",
                      "header": "Book Title",
                      "sortable": true,
                      "fontWeight": "600",
                      "color": "#1a1a1a"
                    },
                    {
                      "field": "checkoutDate",
                      "header": "Checked Out",
                      "sortable": true,
                      "color": "#666666"
                    },
                    {
                      "field": "dueDate",
                      "header": "Due Date",
                      "sortable": true,
                      "color": "#d32f2f",
                      "fontWeight": "600"
                    },
                    {
                      "field": "status",
                      "header": "Status",
                      "badge": true,
                      "color": "#1976d2"
                    }
                  ],
                  "pagination": true,
                  "pageSize": 5,
                  "striped": true,
                  "hover": true,
                  "borderRadius": "8px"
                }
              }
            ]
          },
          {
            "type": "card",
            "config": {
              "title": "Account Summary",
              "backgroundColor": "#ffffff",
              "borderRadius": "12px",
              "padding": "24px",
              "shadow": "0 2px 8px rgba(0,0,0,0.08)",
              "border": "1px solid #e0e0e0"
            },
            "dataBinding": "Member.current",
            "components": [
              {
                "type": "list",
                "config": {
                  "items": [
                    {
                      "label": "Outstanding Fees",
                      "value": "{{Member.current.outstandingFees}}",
                      "icon": "payment",
                      "color": "#d32f2f",
                      "fontWeight": "600",
                      "fontSize": "18px"
                    },
                    {
                      "label": "Active Reservations",
                      "value": "{{Reservation.count}}",
                      "icon": "bookmark",
                      "color": "#1976d2",
                      "fontWeight": "600",
                      "fontSize": "18px"
                    },
                    {
                      "label": "Books Checked Out",
                      "value": "{{Transaction.active.count}}",
                      "icon": "book",
                      "color": "#388e3c",
                      "fontWeight": "600",
                      "fontSize": "18px"
                    }
                  ],
                  "layout": "horizontal",
                  "spacing": "24px",
                  "divider": true
                }
              }
            ]
          },
          {
            "type": "card",
            "config": {
              "title": "My Reservations",
              "backgroundColor": "#ffffff",
              "borderRadius": "12px",
              "padding": "24px",
              "shadow": "0 2px 8px rgba(0,0,0,0.08)",
              "border": "1px solid #e0e0e0"
            },
            "dataBinding": "Reservation.query",
            "components": [
              {
                "type": "table",
                "config": {
                  "columns": [
                    {
                      "field": "book.title",
                      "header": "Book Title",
                      "sortable": true,
                      "fontWeight": "600",
                      "color": "#1a1a1a"
                    },
                    {
                      "field": "reservationDate",
                      "header": "Reserved On",
                      "sortable": true,
                      "color": "#666666"
                    },
                    {
                      "field": "status",
                      "header": "Status",
                      "badge": true,
                      "color": "#1976d2"
                    },
                    {
                      "field": "expiryDate",
                      "header": "Expires",
                      "sortable": true,
                      "color": "#666666"
                    }
                  ],
                  "pagination": true,
                  "pageSize": 5,
                  "striped": true,
                  "hover": true,
                  "borderRadius": "8px"
                }
              }
            ]
          },
          {
            "type": "card",
            "config": {
              "title": "Search & Reserve Books",
              "backgroundColor": "#f5f5f5",
              "borderRadius": "12px",
              "padding": "24px",
              "shadow": "0 2px 8px rgba(0,0,0,0.08)",
              "border": "1px solid #e0e0e0"
            },
            "formRef": "booksearchreservationform-1764475132534-p6aqvi",
            "components": [
              {
                "type": "form",
                "config": {
                  "formId": "booksearchreservationform-1764475132534-p6aqvi",
                  "submitButtonText": "Search Books",
                  "submitButtonColor": "#1976d2",
                  "submitButtonVariant": "contained",
                  "borderRadius": "8px",
                  "spacing": "16px"
                }
              }
            ]
          }
        ]
      }
    ],
    "navigation": {
