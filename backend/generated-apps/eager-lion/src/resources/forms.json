  {
    "id": "memberregistrationform-1764475094961-4x13w3",
    "name": "MemberRegistrationForm",
    "title": "Library Member Registration",
    "description": "Register as a new library member to access our collection and services",
    "fields": [
      {
        "id": "first-name",
        "name": "firstName",
        "type": "text",
        "label": "First Name",
        "placeholder": "Enter your first name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "pattern": "^[a-zA-Z\\s'-]+$",
          "message": "Please enter a valid first name"
        },
        "defaultValue": null
      },
      {
        "id": "last-name",
        "name": "lastName",
        "type": "text",
        "label": "Last Name",
        "placeholder": "Enter your last name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "pattern": "^[a-zA-Z\\s'-]+$",
          "message": "Please enter a valid last name"
        },
        "defaultValue": null
      },
      {
        "id": "email",
        "name": "email",
        "type": "email",
        "label": "Email Address",
        "placeholder": "your.email@example.com",
        "required": true,
        "validation": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "message": "Please enter a valid email address"
        },
        "defaultValue": null
      },
      {
        "id": "phone",
        "name": "phone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "(555) 123-4567",
        "required": true,
        "validation": {
          "pattern": "^[\\d\\s()+-]+$",
          "min": 10,
          "message": "Please enter a valid phone number"
        },
        "defaultValue": null
      },
      {
        "id": "date-of-birth",
        "name": "dateOfBirth",
        "type": "date",
        "label": "Date of Birth",
        "placeholder": "MM/DD/YYYY",
        "required": true,
        "validation": {
          "message": "You must be at least 13 years old to register"
        },
        "defaultValue": null
      },
      {
        "id": "id-type",
        "name": "idType",
        "type": "select",
        "label": "Identification Type",
        "placeholder": "Select ID type",
        "required": true,
        "options": [
          "Driver's License",
          "Passport",
          "State ID",
          "Student ID"
        ],
        "defaultValue": null
      },
      {
        "id": "address",
        "name": "address",
        "type": "textarea",
        "label": "Residential Address",
        "placeholder": "Enter your complete address including street, city, state, and ZIP code",
        "required": true,
        "validation": {
          "min": 10,
          "max": 200,
          "message": "Please enter your complete address"
        },
        "defaultValue": null
      },
      {
        "id": "terms-agreement",
        "name": "termsAgreement",
        "type": "checkbox",
        "label": "I agree to the library terms and conditions",
        "required": true,
        "validation": {
          "message": "You must agree to the terms and conditions"
        },
        "defaultValue": false
      }
