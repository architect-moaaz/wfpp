  {
    "id": "checkoutreturnform-1764475114336-36qeph",
    "name": "CheckoutReturnForm",
    "title": "Book Checkout & Return",
    "description": "Process book checkouts with due date assignment and returns with automatic late fee calculation",
    "fields": [
      {
        "id": "transaction-type",
        "name": "transactionType",
        "type": "radio",
        "label": "Transaction Type",
        "placeholder": "",
        "required": true,
        "options": [
          "Checkout",
          "Return"
        ],
        "defaultValue": "Checkout"
      },
      {
        "id": "member-id",
        "name": "memberId",
        "type": "text",
        "label": "Member ID",
        "placeholder": "Enter member ID or scan card",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9]{6,10}$",
          "message": "Member ID must be 6-10 alphanumeric characters"
        }
      },
      {
        "id": "book-isbn",
        "name": "bookIsbn",
        "type": "text",
        "label": "Book ISBN",
        "placeholder": "Enter ISBN or scan barcode",
        "required": true,
        "validation": {
          "pattern": "^(97[89])?[0-9]{9}[0-9X]$",
          "message": "Please enter a valid ISBN-10 or ISBN-13"
        }
      },
      {
        "id": "due-date",
        "name": "dueDate",
        "type": "date",
        "label": "Due Date",
        "placeholder": "Select due date",
        "required": false,
        "validation": {
          "message": "Due date must be in the future"
        }
      },
      {
        "id": "return-condition",
        "name": "returnCondition",
        "type": "select",
        "label": "Return Condition",
        "placeholder": "Select book condition",
        "required": false,
        "options": [
          "Excellent",
          "Good",
          "Fair",
          "Damaged"
        ]
      },
      {
        "id": "late-fee-override",
        "name": "lateFeeOverride",
        "type": "checkbox",
        "label": "Waive Late Fee",
        "placeholder": "",
        "required": false,
        "defaultValue": false
      },
      {
        "id": "notes",
        "name": "notes",
        "type": "textarea",
        "label": "Notes",
        "placeholder": "Add any additional notes about this transaction",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Notes must not exceed 500 characters"
        }
      }
