[
  {
    "id": "ticketsubmissionform-1765045920360-smjnbt",
    "name": "TicketSubmissionForm",
    "title": "Submit a Support Ticket",
    "description": "Fill out the form below to submit a new support ticket. Our team will respond as soon as possible.",
    "fields": [
      {
        "id": "ticket-title",
        "name": "ticketTitle",
        "type": "text",
        "label": "Ticket Title",
        "placeholder": "Brief summary of your issue",
        "required": true,
        "validation": {
          "min": 5,
          "max": 100,
          "message": "Title must be between 5 and 100 characters"
        },
        "defaultValue": null
      },
      {
        "id": "ticket-category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "placeholder": "Select a category",
        "required": true,
        "options": [
          "Technical Issue",
          "Billing & Payment",
          "Account Access",
          "Feature Request",
          "General Inquiry",
          "Bug Report"
        ],
        "validation": {
          "message": "Please select a category"
        },
        "defaultValue": null
      },
      {
        "id": "ticket-priority",
        "name": "priority",
        "type": "select",
        "label": "Priority",
        "placeholder": "Select priority level",
        "required": true,
        "options": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ],
        "validation": {
          "message": "Please select a priority level"
        },
        "defaultValue": "Medium"
      },
      {
        "id": "ticket-description",
        "name": "description",
        "type": "textarea",
        "label": "Detailed Description",
        "placeholder": "Please provide a detailed description of your issue, including any steps to reproduce, error messages, or relevant information...",
        "required": true,
        "validation": {
          "min": 20,
          "max": 2000,
          "message": "Description must be between 20 and 2000 characters"
        },
        "defaultValue": null
      },
      {
        "id": "ticket-attachments",
        "name": "attachments",
        "type": "file",
        "label": "Attachments (Optional)",
        "placeholder": "Upload screenshots, logs, or relevant files",
        "required": false,
        "validation": {
          "maxSize": 10485760,
          "allowedTypes": [
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".pdf",
            ".doc",
            ".docx",
            ".txt",
            ".log"
          ],
          "maxFiles": 5,
          "message": "Maximum 5 files, 10MB each. Allowed: images, PDFs, documents, logs"
        },
        "defaultValue": null
      }
    ],
    "gridLayout": [
      {
        "i": "ticket-title",
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8,
        "minW": 12,
        "minH": 8
      },
      {
        "i": "ticket-category",
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 8
      },
      {
        "i": "ticket-priority",
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 8
      },
      {
        "i": "ticket-description",
