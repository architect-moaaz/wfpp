[
  {
    "id": "contact-list-page-1767694000527",
    "name": "Contact List Page",
    "title": "Contacts",
    "description": "Main page displaying all contacts with search and action buttons",
    "route": "/contacts",
    "type": "list",
    "platform": "both",
    "forms": [
      "contact-form-1767694000527-fges0a"
    ],
    "sections": [
      {
        "id": "header",
        "type": "header",
        "components": [
          {
            "type": "text",
            "config": {
              "text": "Contact Directory",
              "variant": "h1",
              "align": "left"
            }
          },
          {
            "type": "button",
            "config": {
              "label": "Add New Contact",
              "variant": "primary",
              "action": "navigate",
              "target": "/add-contact",
              "icon": "add"
            }
          }
        ]
      },
      {
        "id": "main",
        "type": "main",
        "components": [
          {
            "type": "search",
            "config": {
              "placeholder": "Search contacts by name, email, or phone...",
              "variant": "outlined",
              "fullWidth": true
            },
            "dataBinding": "Contact.search"
          },
          {
            "type": "table",
            "config": {
              "title": "All Contacts",
              "columns": [
                {
                  "field": "firstName",
                  "header": "First Name",
                  "sortable": true
                },
                {
                  "field": "lastName",
                  "header": "Last Name",
                  "sortable": true
                },
                {
                  "field": "email",
                  "header": "Email",
                  "sortable": true
                },
                {
                  "field": "phone",
                  "header": "Phone",
                  "sortable": false
                },
                {
                  "field": "actions",
                  "header": "Actions",
                  "type": "actions",
                  "actions": [
                    {
                      "label": "View",
                      "icon": "view",
                      "action": "view"
                    },
                    {
                      "label": "Edit",
                      "icon": "edit",
                      "action": "edit"
                    },
                    {
                      "label": "Delete",
                      "icon": "delete",
                      "action": "delete",
                      "confirm": true
                    }
                  ]
                }
              ],
              "pagination": true,
              "pageSize": 10,
              "selectable": false,
              "responsive": true
            },
            "dataBinding": "Contact.list"
          }
        ]
      }
    ],
    "navigation": {
      "onAction": {
        "edit": {
          "type": "navigate",
          "target": "/edit-contact/:id"
        },
        "delete": {
          "type": "workflow",
          "workflow": "Delete Contact",
          "confirm": {
            "title": "Delete Contact",
            "message": "Are you sure you want to delete this contact? This action cannot be undone."
          }
        }
      },
      "menu": [
        {
          "label": "Contact List",
          "route": "/contacts",
          "icon": "list"
        },
        {
          "label": "Add Contact",
          "route": "/add-contact",
          "icon": "add"
        },
        {
          "label": "Contact Directory",
          "route": "/contact-directory",
          "icon": "directory"
        }
      ]
    },
    "pageAssociation": {
      "requiresAuth": true
    },
    "workflowId": "wf-add-new-contact"
  },
  {
    "id": "add-contact-page-1767694000528",
    "name": "Add Contact Page",
    "title": "Add New Contact",
    "description": "Page for creating a new contact",
