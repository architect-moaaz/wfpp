{
  "name": "kind-panda-light",
  "mode": "light",
  "industry": "general",
  "applicationType": "general",
  "colors": {
    "primary": "#2563eb",
    "secondary": "#64748b",
    "accent": "#059669",
    "background": "#ffffff",
    "cardBackground": "#ffffff",
    "cardBorder": "#e2e8f0",
    "text": "#0f172a",
    "textSecondary": "#475569",
    "textMuted": "#64748b",
    "border": "#e2e8f0",
    "input": "#ffffff",
    "inputBorder": "#d1d5db",
    "focus": "#2563eb",
    "error": "#dc2626",
    "success": "#059669",
    "warning": "#d97706",
    "info": "#0ea5e9"
  },
  "typography": {
    "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "headingFontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "monoFontFamily": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "baseFontSize": "14px",
    "headingWeight": "600",
    "bodyWeight": "400",
    "lineHeight": "1.5"
  },
  "spacing": {
    "unit": "4px",
    "pagePadding": "24px",
    "cardPadding": "20px",
    "sectionGap": "32px",
    "fieldGap": "16px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "2px",
    "base": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "base": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "card": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "cardHover": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
  },
  "layout": {
    "type": "sidebar",
    "sidebarWidth": "240px",
    "sidebarPosition": "left",
    "sidebarCollapsible": true,
    "sidebarCollapsedWidth": "64px",
    "containerMaxWidth": "1200px",
    "contentPadding": "24px",
    "headerHeight": "64px",
    "emphasis": "visual-hierarchy",
    "gridColumns": 12,
    "defaultCardLayout": "grid",
    "recommendedComponents": [
      "card",
      "button",
      "input",
      "table",
      "badge",
      "avatar",
      "tabs",
      "dialog",
      "dropdown-menu",
      "form",
      "label",
      "separator"
    ],
    "pageTemplates": {
      "dashboard": {
        "sections": [
          "metrics",
          "charts",
          "recent-activity",
          "quick-actions"
        ],
        "columns": 12,
        "metricsPerRow": 4
      },
      "list": {
        "style": "table",
        "pagination": "numbered",
        "filtersPosition": "top"
      },
      "detail": {
        "layout": "single-column",
        "actionsPosition": "top"
      },
      "form": {
        "layout": "single-column",
        "labelPosition": "top",
        "submitPosition": "bottom"
      }
    }
  },
  "designRationale": "Given the limited information available, I've designed a flexible, general-purpose theme that can adapt to various use cases. The 'kind_panda' name suggests friendliness, so I've chosen approachable colors with a professional blue primary and gentle green accent. The layout emphasizes visual hierarchy with generous spacing and clear typography, making it suitable for both data-heavy and content-focused applications. The sidebar layout provides good navigation structure while maintaining flexibility for future expansion. The design follows modern enterprise application patterns with clean shadows, rounded corners, and accessible color contrasts."
}