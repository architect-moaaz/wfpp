[
  {
    "id": "rule_start_registration",
    "name": "Start Registration Rule",
    "description": "Validate required fields are present when user registration starts",
    "type": "validation",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.email",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "User.email",
          "message": "Email address is required to start registration"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_validate_registration_data",
    "name": "Validate Registration Data Rule",
    "description": "Ensure email format is valid and username meets minimum length",
    "type": "validation",
    "priority": 2,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.email",
          "operator": "contains",
          "value": "@"
        },
        {
          "field": "User.username",
          "operator": "greaterThan",
          "value": 3
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "validationStatus",
          "value": "passed"
        },
        {
          "type": "logMessage",
          "message": "Registration data validation successful"
        }
      ]
    },
    "node_id": "validation-1",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_validation_passed_decision",
    "name": "Validation Passed? Rule",
    "description": "Route workflow based on validation results",
    "type": "decision",
    "priority": 3,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "validationStatus",
          "operator": "equals",
          "value": "passed"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "nextStep",
          "value": "verifyEmail"
        },
        {
          "type": "logMessage",
          "message": "Proceeding to email verification"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_fix_registration_errors",
    "name": "Fix Registration Errors Rule",
    "description": "Notify user of validation errors and require corrections",
    "type": "notification",
    "priority": 4,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "validationStatus",
          "operator": "notEquals",
          "value": "passed"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "sendNotification",
          "field": "User.email",
          "message": "Please correct the following errors: Invalid email format or username too short"
        },
        {
          "type": "setVariable",
          "field": "nextStep",
          "value": "fixErrors"
        }
      ]
    },
    "node_id": "userTask-1",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_verify_email",
    "name": "Verify Email Rule",
    "description": "Send verification email and track verification status",
    "type": "automation",
    "priority": 5,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.emailVerified",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "sendNotification",
          "field": "User.email",
          "message": "Please verify your email address by clicking the link sent to your inbox"
        },
        {
          "type": "setVariable",
          "field": "verificationSent",
          "value": true
        },
        {
          "type": "logMessage",
          "message": "Email verification sent to user"
        }
      ]
    },
    "node_id": "userTask-2",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_complete_profile_setup",
    "name": "Complete Profile Setup Rule",
    "description": "Validate profile completion with required fields",
    "type": "validation",
    "priority": 6,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.firstName",
          "operator": "isNull",
          "value": false
        },
        {
          "field": "User.lastName",
          "operator": "isNull",
          "value": false
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "profileComplete",
          "value": true
        },
        {
          "type": "updateData",
          "field": "User.status",
          "value": "profileComplete"
        }
      ]
    },
    "node_id": "userTask-3",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_requires_admin_approval",
    "name": "Requires Admin Approval? Rule",
    "description": "Determine if admin approval is needed based on user role",
    "type": "decision",
    "priority": 7,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.requestedRole",
          "operator": "in",
          "value": [
            "admin",
            "manager"
          ]
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "requiresApproval",
          "value": true
        },
        {
          "type": "setVariable",
          "field": "nextStep",
          "value": "adminReview"
        },
        {
          "type": "logMessage",
          "message": "Admin approval required for elevated role request"
        }
      ]
    },
    "node_id": "decision-2",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_admin_review_approval",
    "name": "Admin Review & Approval Rule",
    "description": "Notify admin and track approval request status",
    "type": "notification",
    "priority": 8,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "requiresApproval",
          "operator": "equals",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "sendNotification",
          "field": "admin@company.com",
          "message": "New user registration requires approval for elevated role"
        },
        {
          "type": "setVariable",
          "field": "User.status",
          "value": "pendingApproval"
        }
      ]
    },
    "node_id": "userTask-4",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  },
  {
    "id": "rule_approved_decision",
    "name": "Approved? Rule",
    "description": "Complete registration or reject based on admin decision",
    "type": "decision",
    "priority": 9,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.approvalStatus",
          "operator": "equals",
          "value": "approved"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "updateData",
          "field": "User.status",
          "value": "active"
        },
        {
          "type": "sendNotification",
          "field": "User.email",
          "message": "Your registration has been approved. Welcome to the task management system!"
        },
        {
          "type": "logMessage",
          "message": "User registration completed successfully"
        }
      ]
    },
    "node_id": "decision-3",
    "workflow_id": "workflow-user-registration",
    "workflowId": "workflow-user-registration",
    "application_id": "app_1768592519468"
  }
]