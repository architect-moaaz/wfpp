  {
    "id": "bookcatalogentryform-1765051375347-mskujo",
    "name": "BookCatalogEntryForm",
    "title": "Book Catalog Entry",
    "description": "Add or update book records in the library catalog with bibliographic data and inventory details",
    "fields": [
      {
        "id": "isbn",
        "name": "isbn",
        "type": "text",
        "label": "ISBN",
        "placeholder": "978-0-123456-78-9",
        "required": true,
        "validation": {
          "pattern": "^(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]$",
          "message": "Please enter a valid ISBN-10 or ISBN-13 format"
        },
        "defaultValue": null
      },
      {
        "id": "title",
        "name": "title",
        "type": "text",
        "label": "Book Title",
        "placeholder": "Enter the complete book title",
        "required": true,
        "validation": {
          "min": 1,
          "max": 255,
          "message": "Title must be between 1 and 255 characters"
        },
        "defaultValue": null
      },
      {
        "id": "author",
        "name": "author",
        "type": "text",
        "label": "Author",
        "placeholder": "Author's full name",
        "required": true,
        "validation": {
          "min": 2,
          "max": 150,
          "message": "Author name must be between 2 and 150 characters"
        },
        "defaultValue": null
      },
      {
        "id": "category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "placeholder": "Select book category",
        "required": true,
        "options": [
