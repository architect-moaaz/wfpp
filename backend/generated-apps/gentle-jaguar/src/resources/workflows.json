      {
        "id": "node_4",
        "data": {
          "label": "AI Category Classification",
          "model": "claude-sonnet-4-5-20250929",
          "prompt": "Classify this support ticket into one of these categories (Technical, Billing, Account, General): Title: ${processData.title}, Description: ${processData.description}. Return only the category name.",
