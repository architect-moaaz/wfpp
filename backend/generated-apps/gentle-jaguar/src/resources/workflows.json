          "description": "AI categorizes ticket based on title and description",
          "temperature": 0.3,
          "outputVariable": "suggestedCategory"
        },
        "type": "llmTask",
        "position": {
          "x": 300,
          "y": 350
        }
      },
      {
        "id": "node_5",
        "data": {
