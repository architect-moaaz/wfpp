          "description": "AI determines ticket priority based on content analysis",
          "temperature": 0.2,
          "outputVariable": "suggestedPriority"
        },
        "type": "llmTask",
        "position": {
          "x": 500,
          "y": 350
        }
      },
      {
        "id": "node_6",
        "data": {
          "label": "Generate Ticket ID",
          "script": "const ticketId = 'TK-' + Date.now() + '-' + Math.floor(Math.random() * 1000); processData.ticketId = ticketId; processData.status = 'new'; processData.createdAt = new Date().toISOString();",
          "scriptType": "JavaScript",
          "description": "Creates unique ticket ID and sets initial status"
        },
        "type": "scriptTask",
        "position": {
          "x": 400,
          "y": 450
        }
      },
      {
        "id": "node_7",
        "data": {
          "label": "Assignment Strategy",
          "condition": "Determine auto-assignment vs manual assignment",
