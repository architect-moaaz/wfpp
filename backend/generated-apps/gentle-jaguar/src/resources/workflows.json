          "model": "claude-sonnet-4-5-20250929",
          "prompt": "Assess the priority level (Low, Medium, High) for this support ticket based on urgency and impact: ${processData.description}. Consider keywords like 'urgent', 'critical', 'broken', 'down'. Return only: Low, Medium, or High.",
