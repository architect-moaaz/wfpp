          "gatewayType": "exclusive"
        },
        "type": "decision",
        "position": {
          "x": 400,
          "y": 550
        }
      },
      {
        "id": "node_8",
        "data": {
          "label": "Auto-Assign Agent",
          "script": "const agents = ['agent1@company.com', 'agent2@company.com', 'agent3@company.com']; const assignedAgent = agents[Math.floor(Math.random() * agents.length)]; processData.assignedAgent = assignedAgent; processData.status = 'assigned';",
          "scriptType": "JavaScript",
          "description": "Automatically assigns ticket to available agent using round-robin"
        },
        "type": "scriptTask",
        "position": {
          "x": 200,
          "y": 650
        }
      },
      {
