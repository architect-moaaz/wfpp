{
  "name": "professional-light-admin",
  "mode": "light",
  "industry": "general",
  "applicationType": "general",
  "colors": {
    "primary": "#2563eb",
    "secondary": "#64748b",
    "accent": "#0ea5e9",
    "background": "#ffffff",
    "cardBackground": "#ffffff",
    "cardBorder": "#e2e8f0",
    "text": "#0f172a",
    "textSecondary": "#334155",
    "textMuted": "#64748b",
    "border": "#e2e8f0",
    "input": "#ffffff",
    "inputBorder": "#d1d5db",
    "focus": "#2563eb",
    "error": "#ef4444",
    "success": "#10b981",
    "warning": "#f59e0b",
    "info": "#0ea5e9"
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "headingFontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "monoFontFamily": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "baseFontSize": "14px",
    "headingWeight": "600",
    "bodyWeight": "400",
    "lineHeight": "1.5"
  },
  "spacing": {
    "unit": "4px",
    "pagePadding": "24px",
    "cardPadding": "20px",
    "sectionGap": "32px",
    "fieldGap": "16px"
  },
  "borderRadius": {
    "none": "0",
    "sm": "2px",
    "base": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "card": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "cardHover": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)"
  },
  "layout": {
    "type": "sidebar",
    "sidebarWidth": "240px",
    "sidebarPosition": "left",
    "sidebarCollapsible": true,
    "sidebarCollapsedWidth": "64px",
    "containerMaxWidth": "1200px",
    "contentPadding": "24px",
    "headerHeight": "64px",
    "emphasis": "visual-hierarchy",
    "gridColumns": 12,
    "defaultCardLayout": "grid",
    "recommendedComponents": [
      "Button",
      "Card",
      "Table",
      "Form",
      "Dialog",
      "Dropdown",
      "Badge",
      "Avatar",
      "Tabs",
      "Sheet",
      "Command",
      "Popover"
    ],
    "pageTemplates": {
      "dashboard": {
        "sections": [
          "metrics",
          "charts",
          "recent-activity",
          "quick-actions"
        ],
        "columns": 12,
        "metricsPerRow": 4
      },
      "list": {
        "style": "table",
        "pagination": "numbered",
        "filtersPosition": "top"
      },
      "detail": {
        "layout": "single-column",
        "actionsPosition": "top"
      },
      "form": {
        "layout": "single-column",
        "labelPosition": "top",
        "submitPosition": "bottom"
      }
    }
  },
  "designRationale": "Given the limited context, I've designed a flexible, professional admin panel theme suitable for any industry. The color palette uses trustworthy blues with excellent contrast ratios. Inter font provides modern readability. The layout emphasizes clean visual hierarchy with collapsible sidebar for space efficiency. Card-based layouts and table views accommodate various data types. The design follows modern UI patterns while remaining adaptable to specific industry needs as the application evolves."
}