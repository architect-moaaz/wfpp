[
  {
    "id": "workflow_1735661234567",
    "name": "Help Desk Ticketing System",
    "edges": [],
    "nodes": [
      {
        "id": "node_start",
        "data": {
          "label": "Ticket Submitted",
          "formId": "ticket-submission-form",
          "trigger": "Customer submits support ticket",
          "formName": "TicketSubmissionForm",
          "description": "Initiates help desk workflow when new ticket is created"
        },
        "type": "startProcess",
        "position": {
          "x": 100,
          "y": 50
        }
      },
      {
        "id": "node_validation",
        "data": {
          "label": "Validate Ticket Data",
          "rules": [
            "title",
            "description",
            "category",
            "customer_email"
          ],
          "ruleType": "required_fields",
          "description": "Ensures all required ticket fields are properly filled"
        },
        "type": "validation",
        "position": {
          "x": 100,
          "y": 150
        }
      },
      {
        "id": "node_categorize",
        "data": {
          "label": "AI Ticket Categorization",
          "model": "claude-sonnet-4-5-20250929",
          "prompt": "Analyze this support ticket and categorize it. Title: ${processData.title}, Description: ${processData.description}. Return category (IT_SUPPORT, BILLING, GENERAL_INQUIRY, BUG_REPORT, FEATURE_REQUEST) and priority (LOW, MEDIUM, HIGH, URGENT) based on urgency indicators.",
          "maxTokens": 200,
          "description": "Uses AI to automatically categorize and prioritize ticket",
          "temperature": 0.3,
          "outputVariable": "aiClassification"
        },
        "type": "llmTask",
        "position": {
          "x": 100,
          "y": 250
        }
      },
      {
        "id": "node_priority_decision",
        "data": {
          "label": "Priority Routing",
          "condition": "Route based on ticket priority level",
          "description": "Routes ticket based on urgency for appropriate handling",
          "gatewayType": "exclusive"
        },
        "type": "decision",
        "position": {
          "x": 100,
          "y": 350
        }
      },
      {
        "id": "node_urgent_escalation",
        "data": {
          "label": "Urgent Alert",
          "channel": "Email + SMS",
          "template": "URGENT ticket requires immediate attention",
          "recipient": "Team Lead",
          "description": "Immediately notifies management of urgent tickets"
        },
        "type": "notification",
        "position": {
          "x": 300,
          "y": 450
        }
      },
      {
        "id": "node_auto_assignment",
        "data": {
          "label": "Auto-Assign Agent",
          "script": "findBestAgent(category, priority, workload)",
          "scriptType": "JavaScript",
          "description": "Automatically assigns ticket to most suitable available agent"
        },
        "type": "scriptTask",
        "position": {
          "x": 100,
          "y": 450
        }
      },
      {
        "id": "node_sla_timer",
        "data": {
          "label": "SLA Response Timer",
          "duration": "PT4H",
          "timerType": "duration",
          "description": "Sets timer based on SLA requirements for ticket priority"
        },
        "type": "timerEvent",
        "position": {
          "x": 100,
          "y": 550
        }
      },
      {
        "id": "node_parallel_gateway",
        "data": {
          "label": "Parallel Processing",
          "branches": "Notify customer + Update dashboard + Log assignment",
