[
  {
    "id": "ticket-management-form",
    "name": "TicketManagementForm",
    "steps": [],
    "title": "Update Ticket",
    "config": {},
    "fields": [
      {
        "id": "ticket-status",
        "name": "status",
        "type": "select",
        "label": "Ticket Status",
        "options": [
          "Open",
          "In Progress",
          "Pending",
          "Resolved",
          "Closed"
        ],
        "required": true,
        "validation": {
          "message": "Please select a ticket status"
        },
        "placeholder": "Select status",
        "defaultValue": "Open"
      },
      {
        "id": "ticket-priority",
        "name": "priority",
        "type": "select",
        "label": "Priority Level",
        "options": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ],
        "required": true,
        "validation": {
          "message": "Please select a priority level"
        },
        "placeholder": "Select priority",
        "defaultValue": "Medium"
      },
      {
        "id": "assigned-agent",
        "name": "assignedAgent",
        "type": "select",
        "label": "Assigned Agent",
        "options": [
          "Unassigned",
          "John Smith",
          "Sarah Johnson",
          "Mike Chen",
          "Emily Davis"
        ],
        "required": false,
        "placeholder": "Select agent",
        "defaultValue": "Unassigned"
      },
      {
        "id": "ticket-category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "options": [
          "Technical Issue",
          "Billing",
          "Feature Request",
          "General Inquiry",
          "Bug Report"
        ],
        "required": true,
        "validation": {
          "message": "Please select a category"
        },
        "placeholder": "Select category",
        "defaultValue": null
      },
      {
        "id": "resolution-notes",
        "name": "resolutionNotes",
        "type": "textarea",
        "label": "Resolution Notes",
        "required": false,
        "validation": {
          "max": 1000,
          "message": "Resolution notes must not exceed 1000 characters"
        },
        "placeholder": "Enter resolution details or internal notes..."
      },
      {
        "id": "customer-comment",
        "name": "comment",
        "type": "textarea",
        "label": "Add Comment",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Comment must not exceed 500 characters"
        },
        "placeholder": "Add a comment to the ticket..."
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "ticket-details",
          "title": "Ticket Details",
          "fieldIds": [
            "ticket-status",
            "ticket-priority",
            "assigned-agent",
            "ticket-category"
          ]
        },
        {
          "id": "notes-comments",
          "title": "Notes & Comments",
          "fieldIds": [
            "resolution-notes",
            "customer-comment"
          ]
        }
      ]
    },
