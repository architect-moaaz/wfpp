[
  {
    "id": "rule_start_sync_validation",
    "name": "startProcess",
    "description": "Validate inventory sync request has required product and inventory data before processing",
    "type": "validation",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Product.id",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "validationError",
          "value": "INVALID_PRODUCT",
          "message": "Product ID is required for inventory sync"
        },
        {
          "type": "logMessage",
          "field": "errorLog",
          "value": "Inventory sync failed: Missing product identifier",
          "message": "Validation failed at start process"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "inventory-sync-workflow",
    "workflowId": "inventory-sync-workflow",
    "application_id": "app_1765090518609"
  },
  {
    "id": "rule_api_call_success",
    "name": "API Call Successful?",
    "description": "Determine if external inventory API call returned successful response",
    "type": "decision",
    "priority": 2,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "apiResponse.statusCode",
          "operator": "equals",
          "value": 200
        },
        {
          "field": "apiResponse.data",
          "operator": "isNull",
          "value": false
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "syncStatus",
          "value": "SUCCESS",
          "message": "API call completed successfully"
        },
        {
          "type": "updateData",
          "field": "Inventory.lastSyncedAt",
          "value": "{{currentTimestamp}}",
          "message": "Update inventory sync timestamp"
        },
        {
          "type": "logMessage",
          "field": "syncLog",
          "value": "Inventory data synchronized successfully",
          "message": "API success path"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "inventory-sync-workflow",
    "workflowId": "inventory-sync-workflow",
    "application_id": "app_1765090518609"
  },
  {
    "id": "rule_conflicts_detected",
    "name": "Conflicts Detected?",
    "description": "Check if inventory quantity conflicts exist between local and external system",
    "type": "decision",
    "priority": 3,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Inventory.quantityAvailable",
          "operator": "notEquals",
          "value": "{{apiResponse.data.quantity}}"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "conflictDetected",
          "value": true,
          "message": "Inventory quantity mismatch detected"
        },
        {
          "type": "sendNotification",
          "field": "NotificationLog.type",
          "value": "INVENTORY_CONFLICT",
          "message": "Inventory conflict detected for Product {{Product.id}}: Local={{Inventory.quantityAvailable}}, External={{apiResponse.data.quantity}}"
        },
        {
          "type": "logMessage",
          "field": "conflictLog",
          "value": "Conflict resolution required",
          "message": "Route to manual review queue"
        }
      ]
    },
    "node_id": "decision-2",
    "workflow_id": "inventory-sync-workflow",
    "workflowId": "inventory-sync-workflow",
    "application_id": "app_1765090518609"
  },
  {
    "id": "rule_retry_limit_reached",
    "name": "Retry Limit Reached?",
    "description": "Check if maximum retry attempts for inventory sync have been exceeded",
    "type": "decision",
    "priority": 4,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "retryCount",
          "operator": "greaterThan",
          "value": 3
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "syncStatus",
          "value": "FAILED",
          "message": "Maximum retry attempts exceeded"
        },
        {
          "type": "sendNotification",
          "field": "NotificationLog.type",
          "value": "SYNC_FAILURE",
          "message": "Inventory sync failed after 3 attempts for Product {{Product.id}}. Manual intervention required."
        },
        {
          "type": "stopWorkflow",
          "field": "workflowStatus",
          "value": "TERMINATED",
          "message": "Stopping workflow due to retry limit"
        }
      ]
    },
    "node_id": "decision-3",
    "workflow_id": "inventory-sync-workflow",
    "workflowId": "inventory-sync-workflow",
    "application_id": "app_1765090518609"
  }
]