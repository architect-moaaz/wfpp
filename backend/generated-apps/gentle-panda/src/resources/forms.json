        "y": 8,
        "w": 24,
        "h": 8,
        "minW": 12,
        "minH": 8
      },
      {
        "i": "cardholder-name",
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8,
        "minW": 12,
        "minH": 8
      },
      {
        "i": "expiry-date",
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 8
      },
      {
        "i": "cvv",
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 8
      },
      {
        "i": "billing-zip",
        "x": 0,
