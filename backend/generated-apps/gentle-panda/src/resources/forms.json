[
  {
    "id": "paymentdetailsform-1765090954357-f4nlnn",
    "name": "PaymentDetailsForm",
    "title": "Payment Details",
    "description": "Securely enter your payment information to complete your order",
    "fields": [
      {
        "id": "payment-method",
        "name": "paymentMethod",
        "type": "select",
        "label": "Payment Method",
        "placeholder": "Select payment method",
        "required": true,
        "options": [
          "Credit Card",
          "Debit Card",
          "PayPal",
          "Apple Pay",
          "Google Pay"
        ],
        "defaultValue": null,
        "validation": {
          "message": "Please select a payment method"
        }
      },
      {
        "id": "card-number",
        "name": "cardNumber",
        "type": "text",
        "label": "Card Number",
        "placeholder": "1234 5678 9012 3456",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{13,19}$",
          "message": "Please enter a valid card number (13-19 digits)"
        }
      },
      {
        "id": "cardholder-name",
        "name": "cardholderName",
        "type": "text",
        "label": "Cardholder Name",
        "placeholder": "Name as it appears on card",
        "required": true,
        "validation": {
          "min": 2,
          "max": 100,
          "message": "Please enter the cardholder name"
        }
      },
      {
        "id": "expiry-date",
        "name": "expiryDate",
        "type": "text",
        "label": "Expiry Date",
        "placeholder": "MM/YY",
        "required": true,
        "validation": {
          "pattern": "^(0[1-9]|1[0-2])\\/([0-9]{2})$",
          "message": "Please enter a valid expiry date (MM/YY)"
        }
      },
      {
        "id": "cvv",
        "name": "cvv",
        "type": "text",
        "label": "CVV",
        "placeholder": "123",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{3,4}$",
          "message": "Please enter a valid CVV (3-4 digits)"
        }
      },
      {
        "id": "billing-zip",
        "name": "billingZip",
        "type": "text",
        "label": "Billing ZIP Code",
        "placeholder": "12345",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{5}(-[0-9]{4})?$",
          "message": "Please enter a valid ZIP code"
        }
      },
      {
        "id": "save-payment",
        "name": "savePayment",
        "type": "checkbox",
        "label": "Save payment method for future purchases",
        "required": false,
        "defaultValue": false
      }
    ],
    "gridLayout": [
      {
        "i": "payment-method",
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8,
        "minW": 12,
        "minH": 8
      },
      {
        "i": "card-number",
