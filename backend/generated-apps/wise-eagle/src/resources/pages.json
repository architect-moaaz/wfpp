                              "icon": "play",
                              "content": []
                            },
                            {
                              "id": "completed",
                              "label": "Completed",
                              "icon": "check",
                              "content": []
                            },
                            {
                              "id": "overdue",
                              "label": "Overdue",
                              "icon": "alert-triangle",
                              "content": []
                            }
                          ]
                        }
                      }
                    ]
