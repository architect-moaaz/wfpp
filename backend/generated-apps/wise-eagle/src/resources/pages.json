      {
        "id": "main",
        "type": "main",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "0",
              "maxWidth": "800px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "title": "Task Details",
                    "description": "Provide information about the task you want to create",
                    "shadow": "md",
                    "children": [
                      {
                        "type": "form",
                        "config": {
                          "formId": "create-task-form-1768590804524-kor6mb"
                        },
                        "formRef": "create-task-form-1768590804524-kor6mb"
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "24px"
                        }
                      },
                      {
                        "type": "divider",
                        "config": {}
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "24px"
                        }
                      },
                      {
                        "type": "container",
                        "config": {
                          "padding": "0",
                          "children": [
                            {
                              "type": "buttonGroup",
                              "config": {
                                "buttons": [
                                  {
                                    "label": "Cancel",
                                    "variant": "secondary",
                                    "action": "cancel"
                                  },
                                  {
                                    "label": "Create Task",
                                    "variant": "primary",
                                    "icon": "plus",
                                    "action": "submit"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "32px"
                  }
                },
                {
                  "type": "card",
                  "config": {
                    "title": "Quick Tips",
                    "shadow": "sm",
                    "children": [
                      {
                        "type": "alert",
                        "config": {
                          "variant": "info",
                          "title": "Task Management Best Practices",
                          "message": "Use clear, actionable titles and set realistic deadlines. Break down complex tasks into smaller subtasks for better tracking.",
                          "dismissible": false
                        }
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "16px"
                        }
                      },
                      {
                        "type": "accordion",
                        "config": {
                          "items": [
                            {
                              "id": "naming",
                              "title": "How to name tasks effectively",
                              "content": "Start with an action verb (e.g., 'Review', 'Create', 'Update') and be specific about the outcome. Avoid vague titles like 'Work on project'."
                            },
                            {
                              "id": "priority",
                              "title": "Setting task priorities",
                              "content": "High priority for urgent and important tasks, Medium for important but not urgent, Low for nice-to-have items. Review priorities regularly."
                            },
                            {
                              "id": "deadlines",
                              "title": "Managing deadlines",
                              "content": "Set realistic deadlines with buffer time. Consider dependencies and team availability when scheduling tasks."
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "footer",
