            "type": "container",
            "config": {
              "padding": "24px",
              "children": [
                {
                  "type": "text",
                  "config": {
                    "text": "Need help? Contact support or view our task management guide.",
                    "variant": "caption"
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "8px"
                  }
                },
                {
                  "type": "link",
                  "config": {
                    "text": "View Task Management Guide",
                    "href": "/help/task-management"
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": {
      "onAction": {
