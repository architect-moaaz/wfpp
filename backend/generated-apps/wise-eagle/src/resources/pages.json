  {
    "id": "task-list-view-1768590804524",
    "name": "Task List View",
    "title": "My Tasks",
    "description": "Main page displaying all tasks with complete actions",
    "route": "/tasks",
    "type": "list",
    "platform": "both",
    "forms": [
      "create-task-form-1768590804524-kor6mb"
    ],
    "sections": [
      {
        "id": "header-section",
        "type": "header",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "heading",
                  "config": {
                    "text": "My Tasks",
                    "variant": "h1"
                  }
                },
                {
                  "type": "text",
                  "config": {
                    "text": "Manage and track all your tasks in one place",
                    "variant": "subtitle"
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "16px"
                  }
                },
                {
                  "type": "buttonGroup",
                  "config": {
                    "buttons": [
                      {
                        "label": "Create New Task",
                        "variant": "primary",
                        "icon": "plus"
                      },
                      {
                        "label": "Filter",
                        "variant": "secondary",
                        "icon": "filter"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "stats-section",
        "type": "stats-row",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "grid",
                  "config": {
                    "columns": 4,
                    "gap": "24px",
                    "children": [
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "Total Tasks",
                          "value": "{{totalTasks}}",
                          "icon": "list",
                          "iconColor": "primary",
                          "trend": "+5",
                          "trendDirection": "up"
                        }
                      },
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "In Progress",
                          "value": "{{inProgressTasks}}",
                          "icon": "clock",
                          "iconColor": "warning"
                        }
                      },
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "Completed",
                          "value": "{{completedTasks}}",
                          "icon": "check-circle",
                          "iconColor": "success",
                          "trend": "+12",
                          "trendDirection": "up"
                        }
                      },
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "Overdue",
                          "value": "{{overdueTasks}}",
                          "icon": "alert-circle",
                          "iconColor": "error"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
