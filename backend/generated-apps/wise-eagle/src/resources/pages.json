              ]
            }
          }
        ]
      },
      {
        "id": "main-content",
        "type": "main",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "alert",
                  "config": {
                    "variant": "info",
                    "title": "Pro Tip",
                    "message": "Click on any task to view details or mark it as complete",
                    "dismissible": true
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "24px"
                  }
                },
                {
                  "type": "grid",
                  "config": {
                    "columns": 3,
                    "gap": "24px",
                    "children": [
                      {
                        "type": "card",
                        "config": {
                          "title": "{{task.title}}",
                          "description": "{{task.description}}",
                          "shadow": "md",
                          "hoverElevation": true,
                          "borderRadius": "lg",
                          "children": [
                            {
                              "type": "badge",
                              "config": {
                                "text": "{{task.status}}",
                                "variant": "{{task.statusVariant}}"
                              }
                            },
                            {
                              "type": "spacer",
                              "config": {
                                "height": "12px"
                              }
                            },
                            {
                              "type": "text",
                              "config": {
                                "text": "Due: {{task.dueDate}}",
                                "variant": "caption"
                              }
                            },
                            {
                              "type": "divider",
                              "config": {}
                            },
                            {
                              "type": "progress",
                              "config": {
                                "variant": "bar",
                                "value": "{{task.progress}}",
                                "showPercent": true
                              }
                            }
                          ],
                          "actions": [
                            {
                              "label": "View Details",
                              "icon": "eye",
                              "action": "view"
                            },
                            {
                              "label": "Mark Complete",
                              "icon": "check",
                              "action": "complete"
                            },
                            {
                              "label": "Edit",
                              "icon": "edit",
                              "action": "edit"
                            }
                          ]
                        },
                        "dataBinding": "Task.list"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
