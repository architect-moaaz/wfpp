  {
    "id": "leavepolicyform-1764505528831-vqdg1f",
    "name": "LeavePolicyForm",
    "title": "Leave Policy Configuration",
    "description": "Configure leave types, entitlements, and accrual rules for organizational leave policies",
    "fields": [
      {
        "id": "policy-name",
        "name": "policyName",
        "type": "text",
        "label": "Policy Name",
        "placeholder": "e.g., Annual Leave, Sick Leave",
        "required": true,
        "validation": {
          "min": 3,
          "max": 50,
          "message": "Policy name must be between 3 and 50 characters"
        },
        "defaultValue": null
      },
      {
        "id": "leave-type",
        "name": "leaveType",
        "type": "select",
        "label": "Leave Type",
        "placeholder": "Select leave type",
        "required": true,
        "options": [
          "Annual Leave",
          "Sick Leave",
          "Personal Leave",
          "Parental Leave",
          "Bereavement Leave",
          "Unpaid Leave"
        ],
        "defaultValue": null
      },
      {
        "id": "entitlement-amount",
        "name": "entitlementAmount",
        "type": "number",
        "label": "Annual Entitlement (Days)",
        "placeholder": "e.g., 20",
        "required": true,
        "validation": {
          "min": 0,
          "max": 365,
          "message": "Entitlement must be between 0 and 365 days"
        },
        "defaultValue": null
      },
      {
        "id": "accrual-frequency",
        "name": "accrualFrequency",
        "type": "select",
        "label": "Accrual Frequency",
        "placeholder": "Select accrual frequency",
        "required": true,
        "options": [
          "Monthly",
          "Quarterly",
          "Annually",
          "Per Pay Period"
        ],
        "defaultValue": "Monthly"
      },
      {
        "id": "carryover-enabled",
        "name": "carryoverEnabled",
        "type": "checkbox",
        "label": "Allow Carryover to Next Year",
        "required": false,
        "defaultValue": false
      },
      {
        "id": "max-carryover",
        "name": "maxCarryover",
        "type": "number",
        "label": "Maximum Carryover Days",
        "placeholder": "e.g., 5",
        "required": false,
        "validation": {
          "min": 0,
          "max": 100,
          "message": "Maximum carryover must be between 0 and 100 days"
        },
        "defaultValue": null
      },
      {
        "id": "effective-date",
        "name": "effectiveDate",
        "type": "date",
        "label": "Effective Date",
        "placeholder": "Select effective date",
        "required": true,
        "validation": {
          "message": "Effective date must be a valid date"
        },
        "defaultValue": null
      },
      {
        "id": "policy-notes",
        "name": "policyNotes",
        "type": "textarea",
        "label": "Policy Notes & Conditions",
        "placeholder": "Enter any additional policy details, eligibility criteria, or special conditions...",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Policy notes cannot exceed 500 characters"
        },
        "defaultValue": null
