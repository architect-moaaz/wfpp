              "title": "Filter Tickets",
              "filters": [
                {
                  "field": "status",
                  "label": "Status",
                  "type": "select",
                  "options": [
                    "Open",
                    "In Progress",
                    "Pending",
                    "Resolved",
                    "Closed"
                  ]
                },
                {
                  "field": "priority",
                  "label": "Priority",
                  "type": "select",
                  "options": [
                    "Low",
                    "Medium",
                    "High",
                    "Critical"
                  ]
                },
                {
                  "field": "category",
                  "label": "Category",
                  "type": "select",
