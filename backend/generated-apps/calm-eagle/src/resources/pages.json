    "platform": "both",
    "forms": [
      "ticketsubmissionform-1764486693392-7a3gui"
    ],
    "sections": [
      {
        "id": "header",
        "type": "header",
        "components": [
          {
            "type": "text",
            "config": {
              "text": "Ticket Dashboard",
              "variant": "h1",
              "style": {
                "fontFamily": "Inter, system-ui, sans-serif",
                "fontSize": "28px",
                "fontWeight": "600",
                "color": "#1a1a1a",
                "marginBottom": "8px"
              }
            }
          },
          {
            "type": "text",
            "config": {
              "text": "Monitor ticket metrics, status distribution, and team performance",
