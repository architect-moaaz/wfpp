[
  {
    "id": "task-submission-form",
    "name": "TaskSubmissionForm",
    "steps": [],
    "title": "Create New Task",
    "config": {},
    "fields": [
      {
        "id": "task-title",
        "name": "taskTitle",
        "type": "text",
        "label": "Task Title",
        "required": true,
        "validation": {
          "max": 100,
          "min": 3,
          "message": "Task title must be between 3 and 100 characters"
        },
        "placeholder": "Enter a clear and concise task title",
        "defaultValue": null
      },
      {
        "id": "task-description",
        "name": "taskDescription",
        "type": "textarea",
        "label": "Description",
        "required": true,
        "validation": {
          "max": 1000,
          "min": 10,
          "message": "Description must be between 10 and 1000 characters"
        },
        "placeholder": "Provide detailed information about the task requirements and objectives",
        "defaultValue": null
      },
      {
        "id": "task-priority",
        "name": "taskPriority",
        "type": "select",
        "label": "Priority Level",
        "options": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ],
        "required": true,
        "placeholder": "Select priority level",
        "defaultValue": "Medium"
      },
      {
        "id": "task-assignee",
        "name": "taskAssignee",
        "type": "text",
        "label": "Assignee",
        "required": true,
        "validation": {
          "max": 50,
          "min": 2,
          "message": "Assignee name must be between 2 and 50 characters"
        },
        "placeholder": "Enter assignee name or email",
        "defaultValue": null
      },
      {
        "id": "task-due-date",
        "name": "taskDueDate",
        "type": "date",
        "label": "Due Date",
        "required": true,
        "validation": {
          "message": "Please select a valid future date"
        },
        "placeholder": "Select due date",
        "defaultValue": null
      },
      {
        "id": "task-category",
        "name": "taskCategory",
        "type": "select",
        "label": "Category",
        "options": [
          "Development",
          "Design",
          "Testing",
          "Documentation",
          "Research",
          "Meeting"
        ],
        "required": false,
        "placeholder": "Select task category",
        "defaultValue": null
      }
    ],
    "layout": {
      "type": "single-column",
      "sections": [
        {
          "id": "task-details-section",
          "title": "Task Details",
          "fieldIds": [
            "task-title",
            "task-description"
          ]
        },
        {
          "id": "task-metadata-section",
          "title": "Assignment & Priority",
          "fieldIds": [
            "task-priority",
            "task-assignee",
            "task-due-date",
            "task-category"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {
      "colors": {
        "text": "#1e293b",
        "border": "#e2e8f0",
        "primary": "#3b82f6",
        "secondary": "#64748b",
        "background": "#ffffff"
      },
      "spacing": {
        "fieldGap": "20px",
        "sectionGap": "32px",
        "inputPadding": "12px 16px"
      },
      "components": {
        "input": {
          "height": "44px",
          "borderWidth": "1px",
          "borderRadius": "8px"
        },
        "button": {
          "primary": {
            "color": "#ffffff",
            "padding": "12px 24px",
            "background": "#3b82f6"
          }
        }
      },
      "typography": {
        "fontSize": {
          "input": "16px",
          "label": "14px"
        },
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontWeight": {
          "input": "400",
          "label": "500"
        }
      }
    },
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {
      "mode": "onBlur",
      "showErrors": true
    },
    "description": "Submit a new task with details including title, description, priority level, and assignee information.",
    "data_model_id": null
  }
]