[
  {
    "id": "task-list-page-1768533081615",
    "name": "Task List Page",
    "title": "My Tasks",
    "description": "Main page displaying all tasks with status indicators and completion actions",
    "route": "/tasks",
    "type": "list",
    "platform": "both",
    "forms": [
      "task-creation-form-1768533081615-ptiwgt"
    ],
    "sections": [
      {
        "id": "header",
        "type": "header",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "heading",
                  "config": {
                    "text": "My Tasks",
                    "variant": "h1"
                  }
                },
                {
                  "type": "text",
                  "config": {
                    "text": "Manage and track your tasks efficiently",
                    "variant": "subtitle"
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "16px"
                  }
                },
                {
                  "type": "button",
                  "config": {
                    "label": "Create New Task",
                    "variant": "primary",
                    "icon": "plus"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "stats-section",
        "type": "stats-row",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "0 24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "grid",
                  "config": {
                    "columns": 3,
                    "gap": "24px",
                    "children": [
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "Total Tasks",
                          "value": "{{totalTasks}}",
                          "icon": "clipboard-list",
                          "iconColor": "primary",
                          "trend": "+3 this week",
                          "trendDirection": "up"
                        }
                      },
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "In Progress",
                          "value": "{{inProgressTasks}}",
                          "icon": "clock",
                          "iconColor": "warning"
                        }
                      },
                      {
                        "type": "stat-card",
                        "config": {
                          "title": "Completed",
                          "value": "{{completedTasks}}",
                          "icon": "check-circle",
                          "iconColor": "success",
                          "trend": "{{completionRate}}%",
                          "trendDirection": "up"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "filters-section",
        "type": "filters",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "shadow": "sm",
                    "borderRadius": "md",
                    "children": [
                      {
                        "type": "grid",
                        "config": {
                          "columns": 4,
                          "gap": "16px",
                          "children": [
                            {
                              "type": "search",
                              "config": {
                                "placeholder": "Search tasks..."
                              }
                            },
                            {
                              "type": "select",
                              "config": {
                                "label": "Status",
                                "options": [
                                  "All",
                                  "Pending",
                                  "In Progress",
                                  "Completed"
                                ]
                              }
                            },
                            {
                              "type": "select",
                              "config": {
                                "label": "Priority",
                                "options": [
                                  "All",
                                  "High",
                                  "Medium",
                                  "Low"
                                ]
                              }
                            },
                            {
                              "type": "select",
                              "config": {
                                "label": "Sort By",
                                "options": [
                                  "Date Created",
                                  "Due Date",
                                  "Priority",
                                  "Status"
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "loading-state",
        "type": "conditional",
        "showWhen": "isLoading",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "48px 24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "spinner",
                  "config": {
                    "size": "large",
                    "label": "Loading tasks..."
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "empty-state",
        "type": "conditional",
        "showWhen": "tasks.length === 0 && !isLoading",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "64px 24px",
              "maxWidth": "600px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "shadow": "md",
                    "borderRadius": "lg",
                    "children": [
                      {
                        "type": "heading",
                        "config": {
                          "text": "No Tasks Yet",
                          "variant": "h3"
                        }
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "16px"
                        }
                      },
                      {
                        "type": "text",
                        "config": {
                          "text": "Get started by creating your first task. Stay organized and track your progress efficiently.",
                          "variant": "body"
                        }
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "24px"
                        }
                      },
                      {
                        "type": "button",
                        "config": {
                          "label": "Create Your First Task",
                          "variant": "primary",
                          "icon": "plus"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "tasks-grid",
        "type": "main",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "grid",
                  "config": {
                    "columns": 3,
                    "gap": "24px",
                    "children": [
                      {
                        "type": "card",
                        "config": {
                          "title": "{{task.title}}",
                          "description": "{{task.description}}",
                          "shadow": "md",
                          "hoverElevation": true,
                          "borderRadius": "lg",
                          "children": [
                            {
                              "type": "spacer",
                              "config": {
                                "height": "12px"
                              }
                            },
                            {
                              "type": "container",
                              "config": {
                                "children": [
                                  {
                                    "type": "badge",
                                    "config": {
                                      "text": "{{task.status}}",
                                      "variant": "{{task.status === 'Completed' ? 'success' : task.status === 'In Progress' ? 'warning' : 'default'}}"
                                    }
                                  },
                                  {
                                    "type": "badge",
                                    "config": {
                                      "text": "{{task.priority}}",
                                      "variant": "{{task.priority === 'High' ? 'error' : task.priority === 'Medium' ? 'warning' : 'info'}}"
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "type": "spacer",
                              "config": {
                                "height": "16px"
                              }
                            },
                            {
                              "type": "divider",
                              "config": {}
                            },
                            {
                              "type": "spacer",
                              "config": {
                                "height": "12px"
                              }
                            },
                            {
                              "type": "text",
                              "config": {
                                "text": "Due: {{task.dueDate}}",
                                "variant": "caption"
                              }
                            },
                            {
                              "type": "text",
                              "config": {
                                "text": "Created: {{task.createdAt}}",
                                "variant": "caption"
                              }
                            }
                          ],
                          "actions": [
                            {
                              "label": "View Details",
                              "icon": "eye",
                              "variant": "secondary"
                            },
                            {
                              "label": "Mark Complete",
                              "icon": "check",
                              "variant": "success"
                            },
                            {
                              "label": "Edit",
                              "icon": "edit",
                              "variant": "primary"
                            }
                          ]
                        },
                        "dataBinding": "tasks"
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "table-view-section",
        "type": "alternate-view",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "title": "All Tasks",
                    "shadow": "md",
                    "borderRadius": "lg",
                    "children": [
                      {
                        "type": "table",
                        "config": {
                          "columns": [
                            {
                              "key": "title",
                              "label": "Task",
                              "sortable": true
                            },
                            {
                              "key": "status",
                              "label": "Status",
                              "sortable": true
                            },
                            {
                              "key": "priority",
                              "label": "Priority",
                              "sortable": true
                            },
                            {
                              "key": "dueDate",
                              "label": "Due Date",
                              "sortable": true
                            },
                            {
                              "key": "actions",
                              "label": "Actions"
                            }
                          ],
                          "dataBinding": "tasks"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "quick-actions",
        "type": "floating-actions",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "1200px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "title": "Quick Actions",
                    "shadow": "lg",
                    "borderRadius": "lg",
                    "children": [
                      {
                        "type": "buttonGroup",
                        "config": {
                          "buttons": [
                            {
                              "label": "Create Task",
                              "variant": "primary",
                              "icon": "plus"
                            },
                            {
                              "label": "Export Tasks",
                              "variant": "secondary",
                              "icon": "download"
                            },
                            {
                              "label": "Filter View",
                              "variant": "secondary",
                              "icon": "filter"
                            },
                            {
                              "label": "Settings",
                              "variant": "secondary",
                              "icon": "settings"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": {
      "onAction": {
        "complete": {
          "type": "workflow",
          "workflow": "Mark Task Complete"
        }
      },
      "menu": [
        {
          "label": "All Tasks",
          "route": "/tasks",
          "icon": "list"
        },
        {
          "label": "Create Task",
          "route": "/create-task",
          "icon": "plus"
        },
        {
          "label": "Dashboard",
          "route": "/dashboard",
          "icon": "home"
        }
      ]
    },
    "_pageAssociation": {
      "workflowName": "View All Tasks",
      "nodeName": "Display Task List"
    },
    "_specName": "Task List Page",
    "pageAssociation": {
      "requiresAuth": true
    },
    "workflowId": "wf-create-task"
  },
  {
    "id": "create-task-page-1768533081615",
    "name": "Create Task Page",
    "title": "Create New Task",
    "description": "Page containing the task creation form with a clean, focused interface for adding new tasks",
    "route": "/tasks/create",
    "type": "form",
    "platform": "both",
    "forms": [
      "task-creation-form-1768533081615-ptiwgt"
    ],
    "sections": [
      {
        "id": "header",
        "type": "header",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "800px",
              "children": [
                {
                  "type": "breadcrumb",
                  "config": {
                    "items": [
                      {
                        "label": "Tasks",
                        "route": "/tasks"
                      },
                      {
                        "label": "Create New",
                        "route": "/tasks/create"
                      }
                    ]
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "16px"
                  }
                },
                {
                  "type": "heading",
                  "config": {
                    "text": "Create New Task",
                    "variant": "h1"
                  }
                },
                {
                  "type": "text",
                  "config": {
                    "text": "Fill in the details below to create a new task. All required fields are marked with an asterisk.",
                    "variant": "subtitle"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "main",
        "type": "main",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "800px",
              "children": [
                {
                  "type": "card",
                  "config": {
                    "title": "Task Information",
                    "shadow": "md",
                    "borderRadius": "lg",
                    "children": [
                      {
                        "type": "form",
                        "config": {
                          "formId": "task-creation-form-1768533081615-ptiwgt"
                        },
                        "formRef": "task-creation-form-1768533081615-ptiwgt"
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "24px"
                        }
                      },
                      {
                        "type": "divider",
                        "config": {}
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "24px"
                        }
                      },
                      {
                        "type": "container",
                        "config": {
                          "padding": "0",
                          "children": [
                            {
                              "type": "buttonGroup",
                              "config": {
                                "buttons": [
                                  {
                                    "label": "Cancel",
                                    "variant": "secondary",
                                    "icon": "x"
                                  },
                                  {
                                    "label": "Create Task",
                                    "variant": "primary",
                                    "icon": "check"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "spacer",
                  "config": {
                    "height": "32px"
                  }
                },
                {
                  "type": "card",
                  "config": {
                    "title": "Quick Tips",
                    "shadow": "sm",
                    "borderRadius": "lg",
                    "children": [
                      {
                        "type": "alert",
                        "config": {
                          "variant": "info",
                          "title": "Task Management Tips",
                          "message": "Use clear, action-oriented titles for your tasks. Add detailed descriptions to provide context for team members.",
                          "dismissible": false
                        }
                      },
                      {
                        "type": "spacer",
                        "config": {
                          "height": "16px"
                        }
                      },
                      {
                        "type": "accordion",
                        "config": {
                          "items": [
                            {
                              "id": "best-practices",
                              "title": "Best Practices",
                              "content": "Break down large tasks into smaller, manageable subtasks. Set realistic deadlines and assign clear ownership."
                            },
                            {
                              "id": "priority-guide",
                              "title": "Setting Priorities",
                              "content": "High priority for urgent tasks, Medium for important but not urgent, Low for tasks that can wait."
                            },
                            {
                              "id": "collaboration",
                              "title": "Collaboration",
                              "content": "Tag team members in task descriptions to notify them. Use comments to keep all communication in one place."
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "id": "footer",
        "type": "footer",
        "components": [
          {
            "type": "container",
            "config": {
              "padding": "24px",
              "maxWidth": "800px",
              "children": [
                {
                  "type": "text",
                  "config": {
                    "text": "Need help? Contact support or view our task management guide.",
                    "variant": "caption"
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "navigation": {
      "onAction": {
        "submit": {
          "type": "navigate",
          "target": "/tasks"
        },
        "cancel": {
          "type": "navigate",
          "target": "/tasks"
        }
      },
      "menu": [
        {
          "label": "Task List",
          "route": "/tasks",
          "icon": "list"
        },
        {
          "label": "Create Task",
          "route": "/tasks/create",
          "icon": "plus"
        }
      ]
    },
    "_pageAssociation": {
      "workflowName": "Create Task",
      "nodeName": "Open Task Creation Form"
    },
    "_specName": "Create Task Page",
    "pageAssociation": {
      "requiresAuth": true
    },
    "workflowId": "wf-create-task"
  }
]