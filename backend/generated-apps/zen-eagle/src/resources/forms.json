  {
    "id": "appealsubmissionform-1764487470801-esa8wg",
    "name": "AppealSubmissionForm",
    "title": "Parking Ticket Appeal Submission",
    "description": "Submit a formal appeal for your parking ticket with supporting evidence and detailed reasoning.",
    "fields": [
      {
        "id": "ticket-number",
        "name": "ticketNumber",
        "type": "text",
        "label": "Ticket Number",
        "placeholder": "Enter your parking ticket number",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9]{6,12}$",
          "message": "Please enter a valid ticket number (6-12 alphanumeric characters)"
        },
        "defaultValue": null
      },
      {
        "id": "contact-email",
        "name": "contactEmail",
        "type": "email",
        "label": "Email Address",
        "placeholder": "your.email@example.com",
        "required": true,
        "validation": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "message": "Please enter a valid email address"
        },
        "defaultValue": null
      },
      {
        "id": "contact-phone",
        "name": "contactPhone",
        "type": "text",
        "label": "Phone Number",
        "placeholder": "(555) 123-4567",
        "required": true,
