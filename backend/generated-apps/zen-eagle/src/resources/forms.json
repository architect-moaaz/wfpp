        "type": "text",
        "label": "Expiry Date",
        "placeholder": "MM/YY",
        "required": true,
        "validation": {
          "pattern": "^(0[1-9]|1[0-2])\\/([0-9]{2})$",
          "message": "Please enter a valid expiry date (MM/YY)"
        },
        "defaultValue": null
      },
      {
        "id": "cvv",
        "name": "cvv",
        "type": "text",
        "label": "CVV",
        "placeholder": "123",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{3,4}$",
          "message": "Please enter a valid CVV (3-4 digits)"
        },
        "defaultValue": null
