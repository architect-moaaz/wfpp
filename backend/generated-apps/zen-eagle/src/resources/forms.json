    "id": "ticketissuanceform-1764487433111-na9fh2",
    "name": "TicketIssuanceForm",
    "title": "Issue Parking Violation Ticket",
    "description": "Create and issue a parking violation ticket with vehicle details, violation type, and location information.",
    "fields": [
      {
        "id": "license-plate",
        "name": "licensePlate",
        "type": "text",
        "label": "License Plate Number",
        "placeholder": "Enter license plate number",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9]{2,8}$",
          "message": "Please enter a valid license plate number (2-8 alphanumeric characters)"
        },
        "defaultValue": null
      },
      {
        "id": "vehicle-make",
        "name": "vehicleMake",
        "type": "text",
        "label": "Vehicle Make/Model",
        "placeholder": "e.g., Toyota Camry",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "message": "Vehicle make/model must be between 2 and 50 characters"
        },
        "defaultValue": null
      },
      {
        "id": "violation-type",
        "name": "violationType",
        "type": "select",
        "label": "Violation Type",
        "placeholder": "Select violation type",
        "required": true,
        "options": [
          "Expired Meter",
          "No Parking Zone",
          "Fire Hydrant Violation",
          "Handicap Zone Violation",
          "Double Parking",
          "Street Cleaning Violation",
          "Overtime Parking",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "location",
        "name": "location",
        "type": "text",
        "label": "Location",
        "placeholder": "GPS coordinates will be auto-filled",
        "required": true,
        "validation": {
          "message": "Location is required"
        },
        "defaultValue": null
