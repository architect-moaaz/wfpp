      {
        "id": "violation-photo",
        "name": "violationPhoto",
        "type": "file",
        "label": "Violation Photo",
        "placeholder": "Upload photo of violation",
        "required": true,
        "validation": {
          "message": "Please upload at least one photo of the violation"
        },
        "defaultValue": null
