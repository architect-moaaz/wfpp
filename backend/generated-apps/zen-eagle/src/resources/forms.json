  {
    "id": "paymentprocessingform-1764487450412-w34pmi",
    "name": "PaymentProcessingForm",
    "title": "Pay Parking Ticket",
    "description": "Securely submit your payment for parking tickets online. Enter your ticket information and payment details below.",
    "fields": [
      {
        "id": "ticket-number",
        "name": "ticketNumber",
        "type": "text",
        "label": "Ticket Number",
        "placeholder": "Enter your ticket number (e.g., TKT-2024-001234)",
        "required": true,
        "validation": {
          "pattern": "^[A-Z]{3}-[0-9]{4}-[0-9]{6}$",
          "message": "Please enter a valid ticket number format (TKT-YYYY-XXXXXX)"
        },
        "defaultValue": null
      },
      {
        "id": "license-plate",
        "name": "licensePlate",
        "type": "text",
        "label": "License Plate Number",
        "placeholder": "Enter vehicle license plate",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9]{2,8}$",
          "message": "Please enter a valid license plate number"
        },
        "defaultValue": null
      },
      {
        "id": "amount-due",
        "name": "amountDue",
        "type": "number",
        "label": "Amount Due",
        "placeholder": "0.00",
        "required": true,
        "validation": {
          "min": 0.01,
          "message": "Amount must be greater than $0.00"
        },
        "defaultValue": null
