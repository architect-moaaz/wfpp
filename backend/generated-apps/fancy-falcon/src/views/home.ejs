<h1>Welcome to <%= appName %></h1>
<p class="lead"><%= appDescription || 'Your application is ready!' %></p>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-file-text"></i> Forms</h5>
                <p class="card-text"><%= formCount %> forms available</p>
                <a href="/forms" class="btn btn-primary">View Forms</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-layout-text-window"></i> Pages</h5>
                <p class="card-text"><%= pageCount %> pages available</p>
                <a href="/pages" class="btn btn-primary">View Pages</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-diagram-3"></i> Workflows</h5>
                <p class="card-text"><%= workflowCount %> workflows available</p>
                <a href="/workflows" class="btn btn-primary">View Workflows</a>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <h3>Quick Start</h3>
    <ul>
        <li>Browse <a href="/forms">Forms</a> to collect data</li>
        <li>View <a href="/pages">Pages</a> to see your application pages</li>
        <li>Check <a href="/workflows">Workflows</a> to see available workflows</li>
        <li>Access the <a href="/api/health" target="_blank">REST API</a> programmatically</li>
    </ul>
</div>