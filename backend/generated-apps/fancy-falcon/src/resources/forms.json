  {
    "id": "ticketsubmissionform-1764612833975-f28gry",
    "name": "TicketSubmissionForm",
    "title": "Submit Support Ticket",
    "description": "Create a new support ticket by providing details about your issue. Our team will respond as soon as possible.",
    "fields": [
      {
        "id": "subject",
        "name": "subject",
        "type": "text",
        "label": "Subject",
        "placeholder": "Brief summary of your issue",
        "required": true,
        "validation": {
          "min": 5,
          "max": 150,
          "message": "Subject must be between 5 and 150 characters"
        },
        "defaultValue": null
      },
      {
        "id": "category",
        "name": "category",
        "type": "select",
        "label": "Category",
        "placeholder": "Select a category",
        "required": true,
        "options": [
          "Hardware Issue",
          "Software Issue",
          "Network/Connectivity",
          "Account Access",
          "Email Problems",
          "Application Support",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "priority",
        "name": "priority",
        "type": "select",
        "label": "Priority",
        "placeholder": "Select priority level",
        "required": true,
        "options": [
          "Low - Minor issue, no immediate impact",
          "Medium - Moderate impact on work",
          "High - Significant impact, urgent attention needed",
          "Critical - System down, work blocked"
        ],
        "defaultValue": null
      },
      {
        "id": "description",
