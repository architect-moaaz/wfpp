        "validation": {
          "min": 20,
          "max": 2000,
          "message": "Description must be between 20 and 2000 characters"
        },
        "defaultValue": null
      },
      {
        "id": "attachment",
        "name": "attachment",
        "type": "file",
        "label": "Attachments (Optional)",
        "placeholder": "Upload screenshots or relevant files",
        "required": false,
        "validation": {
          "message": "Maximum file size: 10MB. Accepted formats: jpg, png, pdf, doc, docx"
        },
        "defaultValue": null
