    "id": "ticketissuanceform-1764453708028-rgsx0z",
    "name": "TicketIssuanceForm",
    "title": "Issue Parking Violation Ticket",
    "description": "Create a new parking violation ticket with vehicle and location details",
    "fields": [
      {
        "id": "license-plate",
        "name": "licensePlate",
        "type": "text",
        "label": "License Plate Number",
        "placeholder": "ABC1234",
        "required": true,
        "validation": {
          "pattern": "^[A-Z0-9]{2,8}$",
          "message": "Enter a valid license plate (2-8 alphanumeric characters)"
        },
        "defaultValue": null
      },
      {
        "id": "vehicle-make",
        "name": "vehicleMake",
        "type": "text",
        "label": "Vehicle Make/Model",
        "placeholder": "Toyota Camry",
        "required": true,
        "validation": {
          "min": 2,
          "max": 50,
          "message": "Enter vehicle make and model"
        },
        "defaultValue": null
      },
      {
        "id": "violation-type",
        "name": "violationType",
        "type": "select",
        "label": "Violation Type",
        "placeholder": "Select violation",
        "required": true,
        "options": [
          "Expired Meter",
          "No Parking Zone",
          "Fire Hydrant",
          "Handicap Zone",
          "Double Parking",
          "Street Cleaning",
          "Other"
        ],
        "defaultValue": null
      },
      {
        "id": "location",
        "name": "location",
        "type": "text",
        "label": "Location/Street Address",
        "placeholder": "123 Main St",
        "required": true,
        "validation": {
          "min": 5,
          "max": 200,
          "message": "Enter the violation location"
        },
        "defaultValue": null
      },
      {
        "id": "gps-coordinates",
        "name": "gpsCoordinates",
        "type": "text",
        "label": "GPS Coordinates",
        "placeholder": "Auto-captured or manual entry",
        "required": false,
        "validation": {
          "pattern": "^-?\\d+\\.\\d+,\\s*-?\\d+\\.\\d+$",
          "message": "Format: latitude, longitude (e.g., 40.7128, -74.0060)"
        },
        "defaultValue": null
      },
      {
        "id": "photo-evidence",
        "name": "photoEvidence",
        "type": "file",
        "label": "Photo Evidence",
        "placeholder": "Upload violation photo",
        "required": false,
        "validation": {
          "message": "Upload JPG, PNG, or HEIC (max 10MB)"
        },
        "defaultValue": null
      },
      {
        "id": "officer-badge",
        "name": "officerBadge",
        "type": "text",
        "label": "Officer Badge Number",
        "placeholder": "12345",
        "required": true,
        "validation": {
          "pattern": "^[0-9]{3,6}$",
          "message": "Enter valid badge number (3-6 digits)"
        },
        "defaultValue": null
      },
      {
        "id": "notes",
        "name": "notes",
        "type": "textarea",
        "label": "Additional Notes",
        "placeholder": "Optional details about the violation",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Notes cannot exceed 500 characters"
        },
        "defaultValue": null
      }
