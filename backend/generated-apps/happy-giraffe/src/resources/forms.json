          "pattern": "^[A-Z0-9]{2,8}$",
          "message": "Please enter a valid license plate number"
        },
        "defaultValue": null
      },
      {
        "id": "fine-amount",
        "name": "fineAmount",
        "type": "number",
        "label": "Fine Amount",
        "placeholder": "Amount will be displayed automatically",
        "required": true,
