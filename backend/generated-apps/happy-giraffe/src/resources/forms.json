  {
    "id": "appealsubmissionform-1764453749466-bel0kp",
    "name": "AppealSubmissionForm",
    "title": "Parking Ticket Appeal Submission",
    "description": "Submit an appeal for your parking ticket with supporting documentation and justification.",
    "fields": [
      {
        "id": "ticket-number",
        "name": "ticketNumber",
        "type": "text",
        "label": "Ticket Number",
        "placeholder": "Enter your parking ticket number (e.g., PKT-123456)",
        "required": true,
        "validation": {
          "pattern": "^[A-Z]{3}-[0-9]{6}$",
          "message": "Please enter a valid ticket number format (e.g., PKT-123456)"
        },
        "defaultValue": null
      },
      {
        "id": "license-plate",
