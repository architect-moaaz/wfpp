[
  {
    "id": "rule_start_survey_creation",
    "name": "Start Survey Creation Rule",
    "description": "Validate survey title and creator information before initiating survey creation process",
    "type": "validation",
    "priority": 100,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.title",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "Survey.title",
          "value": null,
          "message": "Survey title is required to start survey creation"
        },
        {
          "type": "logMessage",
          "field": "system.log",
          "value": "Survey creation failed - missing title",
          "message": "Validation error logged"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_design_survey_validation",
    "name": "Design Survey Rule",
    "description": "Validate that survey has minimum required questions and valid question types",
    "type": "validation",
    "priority": 90,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.questions.length",
          "operator": "lessThan",
          "value": 1
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "Survey.questions",
          "value": null,
          "message": "Survey must contain at least one question"
        },
        {
          "type": "setVariable",
          "field": "Survey.status",
          "value": "draft",
          "message": "Survey status set to draft"
        }
      ]
    },
    "node_id": "userTask-1",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_validate_survey_structure",
    "name": "Validate Survey Structure Rule",
    "description": "Check survey structure completeness including questions, types, and required fields",
    "type": "validation",
    "priority": 85,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Question.text",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "Question.text",
          "value": "required",
          "message": "All questions must have text content"
        },
        {
          "type": "setVariable",
          "field": "Survey.validationStatus",
          "value": "failed",
          "message": "Validation failed"
        },
        {
          "type": "logMessage",
          "field": "system.log",
          "value": "Survey structure validation failed",
          "message": "Validation error recorded"
        }
      ]
    },
    "node_id": "validation-1",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_validation_passed_decision",
    "name": "Validation Passed Decision Rule",
    "description": "Determine if survey passes all validation checks to proceed to review",
    "type": "decision",
    "priority": 80,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.validationStatus",
          "operator": "equals",
          "value": "passed"
        },
        {
          "field": "Survey.questions.length",
          "operator": "greaterThan",
          "value": 0
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "workflow.nextStep",
          "value": "review_and_approve",
          "message": "Route to review and approval"
        },
        {
          "type": "updateData",
          "field": "Survey.status",
          "value": "pending_review",
          "message": "Survey ready for review"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_fix_validation_issues",
    "name": "Fix Validation Issues Rule",
    "description": "Track validation issue fixes and ensure all errors are addressed",
    "type": "validation",
    "priority": 75,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.validationErrors.length",
          "operator": "equals",
          "value": 0
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "Survey.validationStatus",
          "value": "passed",
          "message": "All validation issues resolved"
        },
        {
          "type": "updateData",
          "field": "Survey.lastModified",
          "value": "currentTimestamp",
          "message": "Update modification timestamp"
        },
        {
          "type": "logMessage",
          "field": "system.log",
          "value": "Survey validation issues fixed",
          "message": "Validation success logged"
        }
      ]
    },
    "node_id": "userTask-2",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_review_approve_notification",
    "name": "Review and Approve Rule",
    "description": "Send notification to stakeholders when survey is submitted for approval",
    "type": "notification",
    "priority": 70,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.status",
          "operator": "equals",
          "value": "pending_review"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "approver_email",
          "message": "Survey is ready for review and approval"
        },
        {
          "type": "setVariable",
          "field": "Survey.submittedForReviewAt",
          "value": "currentTimestamp",
          "message": "Record review submission time"
        }
      ]
    },
    "node_id": "userTask-3",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_approved_decision",
    "name": "Approved Decision Rule",
    "description": "Route survey based on approval decision to publish or revise",
    "type": "decision",
    "priority": 65,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.approvalStatus",
          "operator": "equals",
          "value": "approved"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "Survey.status",
          "value": "published",
          "message": "Survey approved and published"
        },
        {
          "type": "updateData",
          "field": "Survey.publishedAt",
          "value": "currentTimestamp",
          "message": "Set publication timestamp"
        },
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "creator_email",
          "message": "Your survey has been approved and published"
        }
      ]
    },
    "node_id": "decision-2",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  },
  {
    "id": "rule_revise_survey",
    "name": "Revise Survey Rule",
    "description": "Handle survey revision requests and notify creator of required changes",
    "type": "automation",
    "priority": 60,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.approvalStatus",
          "operator": "equals",
          "value": "rejected"
        },
        {
          "field": "Survey.revisionComments",
          "operator": "isNull",
          "value": false
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "Survey.status",
          "value": "revision_required",
          "message": "Survey requires revision"
        },
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "creator_email",
          "message": "Survey requires revisions. Please review feedback and resubmit"
        },
        {
          "type": "setVariable",
          "field": "workflow.nextStep",
          "value": "design_survey",
          "message": "Route back to design phase"
        }
      ]
    },
    "node_id": "userTask-4",
    "workflow_id": "workflow-create-survey",
    "workflowId": "workflow-create-survey",
    "application_id": "app_1768213814702"
  }
]