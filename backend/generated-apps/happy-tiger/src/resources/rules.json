[
  {
    "id": "rule_parking_violation_detected",
    "name": "Parking Violation Detected Rule",
    "description": "Validate officer credentials and violation location data when parking violation is detected",
    "type": "validation",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Officer.badgeNumber",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "Officer.badgeNumber",
          "message": "Officer badge number is required to initiate parking violation"
        },
        {
          "type": "logMessage",
          "message": "Parking violation detection failed - missing officer credentials"
        }
      ]
    },
    "node_id": "node_start",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_issue_parking_ticket",
    "name": "Issue Parking Ticket Rule",
    "description": "Validate vehicle license plate and violation type before issuing ticket",
    "type": "validation",
    "priority": 2,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Vehicle.licensePlate",
          "operator": "equals",
          "value": ""
        },
        {
          "field": "ViolationType.code",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "Vehicle.licensePlate",
          "message": "Valid license plate number is required"
        },
        {
          "type": "validateField",
          "field": "ViolationType.code",
          "message": "Violation type must be selected"
        },
        {
          "type": "stopWorkflow",
          "message": "Cannot issue ticket without required vehicle and violation information"
        }
      ]
    },
    "node_id": "node_issue_ticket",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_validate_ticket_data",
    "name": "Validate Ticket Data Rule",
    "description": "Ensure ticket amount is within valid range and location data is complete",
    "type": "validation",
    "priority": 3,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.amount",
          "operator": "greaterThan",
          "value": 1000
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "Ticket.amount",
          "message": "Ticket amount exceeds maximum allowed limit of $1000"
        },
        {
          "type": "logMessage",
          "message": "Ticket validation failed - amount exceeds threshold"
        },
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "VALIDATION_FAILED"
        }
      ]
    },
    "node_id": "node_validate_ticket",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_validation_check",
    "name": "Validation Check Rule",
    "description": "Route ticket based on validation status to approval or rejection path",
    "type": "decision",
    "priority": 4,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.validationStatus",
          "operator": "equals",
          "value": "PASSED"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "workflowPath",
          "value": "PROCEED_TO_NOTIFICATION"
        },
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "APPROVED"
        },
        {
          "type": "logMessage",
          "message": "Ticket validation passed - proceeding to notification"
        }
      ]
    },
    "node_id": "node_validation_decision",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_parallel_notification",
    "name": "Parallel Notification Rule",
    "description": "Determine notification channels based on ticket severity and amount",
    "type": "decision",
    "priority": 5,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.amount",
          "operator": "greaterThan",
          "value": 200
        },
        {
          "field": "ViolationType.severity",
          "operator": "equals",
          "value": "HIGH"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "notificationChannels",
          "value": "EMAIL_SMS_MAIL"
        },
        {
          "type": "sendNotification",
          "field": "Notification.type",
          "value": "MULTI_CHANNEL",
          "message": "High severity ticket issued - sending notifications via all channels"
        },
        {
          "type": "logMessage",
          "message": "Parallel notification triggered for high-value ticket"
        }
      ]
    },
    "node_id": "node_notification_split",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_citizen_action_decision",
    "name": "Citizen Action Decision Rule",
    "description": "Route workflow based on citizen response: payment, dispute, or no action",
    "type": "decision",
    "priority": 6,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.citizenAction",
          "operator": "equals",
          "value": "DISPUTE"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "workflowPath",
          "value": "DISPUTE_REVIEW"
        },
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "UNDER_DISPUTE"
        },
        {
          "type": "logMessage",
          "message": "Citizen has filed dispute - routing to review process"
        }
      ]
    },
    "node_id": "node_citizen_action",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_review_dispute",
    "name": "Review Dispute Rule",
    "description": "Validate dispute submission has required evidence and reason",
    "type": "validation",
    "priority": 7,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Dispute.reason",
          "operator": "equals",
          "value": ""
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "Dispute.reason",
          "message": "Dispute reason is required for review"
        },
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "citizen",
          "message": "Your dispute cannot be processed without a valid reason"
        },
        {
          "type": "stopWorkflow",
          "message": "Dispute review halted - incomplete information"
        }
      ]
    },
    "node_id": "node_dispute_review",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_dispute_resolution",
    "name": "Dispute Resolution Rule",
    "description": "Route ticket based on dispute decision: approved, rejected, or escalated",
    "type": "decision",
    "priority": 8,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Dispute.resolution",
          "operator": "equals",
          "value": "APPROVED"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "DISMISSED"
        },
        {
          "type": "setVariable",
          "field": "Ticket.amountDue",
          "value": 0
        },
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "citizen",
          "message": "Your dispute has been approved and the ticket has been dismissed"
        }
      ]
    },
    "node_id": "node_dispute_decision",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_escalation_process",
    "name": "Escalation Process Rule",
    "description": "Validate escalation request has supervisor assignment and justification",
    "type": "validation",
    "priority": 9,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Dispute.escalationJustification",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "Dispute.escalationJustification",
          "message": "Escalation justification is required for supervisor review"
        },
        {
          "type": "logMessage",
          "message": "Escalation validation failed - missing justification"
        },
        {
          "type": "throwError",
          "field": "Dispute.escalationJustification",
          "message": "Cannot escalate dispute without proper justification"
        }
      ]
    },
    "node_id": "node_escalation",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  },
  {
    "id": "rule_handle_system_error",
    "name": "Handle System Error Rule",
    "description": "Validate error recovery data and ensure audit trail is maintained",
    "type": "validation",
    "priority": 10,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "AuditLog.errorCode",
          "operator": "notEquals",
          "value": ""
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "logMessage",
          "message": "System error detected - initiating error handling procedure"
        },
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "ERROR_STATE"
        },
        {
          "type": "sendNotification",
          "field": "Notification.recipient",
          "value": "system_admin",
          "message": "Critical system error in parking ticket workflow requires attention"
        }
      ]
    },
    "node_id": "node_error_handler",
    "workflow_id": "workflow_1735227156483",
    "workflowId": "workflow_1735227156483",
    "application_id": "app_1764935334155"
  }
]