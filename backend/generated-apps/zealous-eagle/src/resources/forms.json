[
  {
    "id": "app_1764181570141_workflow_1703567890123_form_001",
    "name": "book_registration_form",
    "steps": [],
    "title": null,
    "config": {},
    "fields": [
      {
        "type": "text",
        "label": "ISBN",
        "section": "section_book_info",
        "tooltip": "Enter ISBN-10 or ISBN-13 format",
        "required": true,
        "fieldName": "book_isbn",
        "validation": {
          "pattern": "^(?:ISBN(?:-13)?:?\\s*)?(?=[0-9X]{10}$|(?=(?:[0-9]+[-\\s]){3})[-\\s0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[-\\s]){4})[-\\s0-9]{17}$)(?:97[89][-\\s]?)?[0-9]{1,5}[-\\s]?[0-9]+[-\\s]?[0-9]+[-\\s]?[0-9X]$"
        },
        "placeholder": "978-0-123456-78-9"
      },
      {
        "type": "text",
        "label": "Book Title",
        "section": "section_book_info",
        "required": true,
        "fieldName": "book_title",
        "maxLength": 500,
        "placeholder": "Enter the complete book title"
      },
      {
        "type": "tags",
        "label": "Authors",
        "maxTags": 10,
        "section": "section_book_info",
        "tooltip": "Press Enter to add multiple authors",
        "required": true,
        "fieldName": "book_authors",
        "placeholder": "Add author names"
      },
      {
        "type": "multiselect",
        "label": "Categories",
        "options": [
          "Fiction",
          "Non-Fiction",
          "Science",
          "Technology",
          "History",
          "Biography",
          "Arts",
          "Literature",
          "Reference",
          "Children",
          "Young Adult",
          "Academic"
        ],
        "section": "section_book_info",
        "required": true,
        "fieldName": "book_category",
        "maxSelections": 3
      },
      {
        "type": "richtext",
        "label": "Book Description",
        "section": "section_book_info",
        "toolbar": [
          "bold",
          "italic",
          "underline",
          "list",
          "link"
        ],
        "required": false,
        "fieldName": "book_description",
        "placeholder": "Enter detailed description or summary"
      },
      {
        "type": "autocomplete",
        "label": "Publisher",
        "options": [
          "Penguin Random House",
          "HarperCollins",
          "Macmillan",
          "Simon & Schuster",
          "Hachette",
          "Scholastic",
          "Pearson",
          "McGraw-Hill",
          "Cambridge University Press",
          "Oxford University Press"
        ],
        "section": "section_book_info",
        "minChars": 2,
        "required": true,
        "fieldName": "publisher_info"
      },
      {
        "type": "date",
        "label": "Publication Date",
        "maxDate": "today",
        "section": "section_book_info",
        "required": true,
        "fieldName": "publication_date"
      },
      {
        "type": "currency",
        "label": "Acquisition Cost",
        "section": "section_acquisition",
        "required": true,
        "fieldName": "acquisition_cost",
        "validation": {
          "max": 10000,
          "min": 0
        },
        "placeholder": "0.00",
        "currencySymbol": "$"
      },
      {
        "type": "radio",
        "label": "Acquisition Method",
        "options": [
          "Purchase",
          "Donation",
          "Exchange",
          "Gift"
        ],
        "section": "section_acquisition",
        "required": true,
        "fieldName": "acquisition_method"
      },
      {
        "type": "conditional",
        "field": {
          "type": "text",
          "required": true,
          "placeholder": "Enter vendor/supplier name"
        },
        "label": "Vendor Information",
        "section": "section_acquisition",
        "condition": {
          "value": "Purchase",
          "operator": "equals",
          "fieldName": "acquisition_method"
        },
        "fieldName": "vendor_info"
      },
      {
        "type": "conditional",
        "field": {
          "type": "text",
          "required": false,
          "placeholder": "Enter donor name and contact"
        },
        "label": "Donor Information",
        "section": "section_acquisition",
        "condition": {
          "value": [
            "Donation",
            "Gift"
          ],
          "operator": "in",
          "fieldName": "acquisition_method"
        },
        "fieldName": "donor_info"
      },
      {
        "type": "file",
        "label": "Receipt/Invoice",
        "maxSize": "5MB",
        "section": "section_acquisition",
        "maxFiles": 3,
        "required": false,
        "fieldName": "receipt_document",
        "allowedTypes": [
          ".pdf",
          ".jpg",
          ".png",
          ".doc",
          ".docx"
        ]
      },
      {
        "type": "rating",
        "label": "Book Condition",
        "section": "section_physical",
        "tooltip": "1=Poor, 2=Fair, 3=Good, 4=Very Good, 5=Excellent",
        "required": true,
        "fieldName": "book_condition",
        "maxRating": 5,
        "ratingType": "star"
      },
      {
        "type": "dropdown",
        "label": "Physical Location",
        "options": [
          "Main Floor - Fiction",
          "Main Floor - Non-Fiction",
          "Second Floor - Reference",
          "Second Floor - Academic",
          "Children's Section",
          "Young Adult Section",
          "Storage Room A",
          "Storage Room B",
          "Special Collections"
        ],
        "section": "section_physical",
        "required": true,
        "fieldName": "book_location"
      },
      {
        "type": "text",
        "label": "Shelf/Call Number",
        "section": "section_physical",
        "required": true,
        "fieldName": "shelf_location",
        "placeholder": "e.g., 813.54 SMI"
      },
      {
        "max": 100,
        "min": 1,
        "type": "number",
        "label": "Total Copies",
        "section": "section_physical",
        "required": true,
        "fieldName": "total_copies",
        "defaultValue": 1
      },
      {
        "type": "calculated",
        "label": "Available Copies",
        "formula": "total_copies",
        "section": "section_physical",
        "readonly": true,
        "fieldName": "available_copies",
        "dependencies": [
          "total_copies"
        ]
      },
      {
        "type": "switch",
        "label": "Digital Copy Available",
        "section": "section_digital",
        "fieldName": "digital_available",
        "defaultValue": false
      },
      {
        "type": "conditional",
        "field": {
          "type": "file",
          "maxSize": "50MB",
          "maxFiles": 1,
          "allowedTypes": [
            ".pdf",
            ".epub",
            ".mobi"
          ]
        },
        "label": "E-book File",
        "section": "section_digital",
        "condition": {
          "value": true,
          "operator": "equals",
          "fieldName": "digital_available"
        },
        "fieldName": "ebook_file"
      },
      {
        "type": "conditional",
        "field": {
          "type": "dropdown",
          "options": [
            "Single User",
            "Multi User (5)",
            "Multi User (10)",
            "Unlimited",
            "Library Consortium"
          ]
        },
        "label": "Digital License Type",
        "section": "section_digital",
        "condition": {
          "value": true,
          "operator": "equals",
          "fieldName": "digital_available"
        },
        "fieldName": "digital_license"
      },
      {
        "type": "esign",
        "label": "Cataloger Signature",
        "section": "section_digital",
        "required": true,
        "fieldName": "cataloger_signature",
        "canvasWidth": 400,
        "canvasHeight": 150
      }
    ],
    "layout": {},
    "nodeId": null,
    "styling": {},
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {},
    "description": "Comprehensive form for adding new books to the library catalog with detailed metadata and acquisition information",
    "data_model_id": null
  },
  {
    "id": "app_1764181570141_workflow_1703567890123_form_002",
    "name": "member_registration_form",
    "steps": [],
    "title": null,
    "config": {},
    "fields": [
      {
        "type": "text",
        "label": "Member ID",
        "section": "section_personal",
        "readonly": true,
        "required": false,
        "fieldName": "member_id",
        "defaultValue": "AUTO_GENERATED"
      },
      {
        "type": "text",
        "label": "Full Name",
        "section": "section_personal",
        "required": true,
        "fieldName": "full_name",
        "maxLength": 100,
        "placeholder": "Enter full legal name"
      },
      {
        "type": "date",
        "label": "Date of Birth",
        "maxDate": "today",
        "section": "section_personal",
        "required": true,
        "fieldName": "date_of_birth"
      },
      {
        "type": "calculated",
        "label": "Age Category",
        "formula": "calculateAgeCategory(date_of_birth)",
        "section": "section_personal",
        "readonly": true,
        "fieldName": "age_category",
        "dependencies": [
          "date_of_birth"
        ]
      },
      {
        "type": "nationalid",
        "label": "National ID/SSN",
        "masked": true,
        "country": "US",
        "section": "section_personal",
        "required": true,
        "fieldName": "national_id"
      },
      {
        "size": "150x150",
        "type": "avatar",
        "label": "Profile Photo",
        "shape": "circle",
        "section": "section_personal",
        "required": false,
        "fieldName": "profile_photo"
      },
      {
        "type": "email",
        "label": "Primary Email",
        "section": "section_contact",
        "required": true,
        "fieldName": "primary_email",
        "placeholder": "user@example.com"
      },
      {
        "type": "email",
        "label": "Secondary Email (Optional)",
        "section": "section_contact",
        "required": false,
        "fieldName": "secondary_email",
        "placeholder": "alternate@example.com"
      },
      {
        "type": "phoneInput",
        "label": "Primary Phone",
        "section": "section_contact",
        "required": true,
        "fieldName": "primary_phone",
        "defaultCountry": "US"
      },
      {
        "type": "text",
        "label": "Emergency Contact",
        "section": "section_contact",
        "required": true,
        "fieldName": "emergency_contact",
        "placeholder": "Name and phone number"
      },
      {
        "type": "richtext",
        "label": "Complete Address",
        "section": "section_contact",
        "required": true,
        "fieldName": "address_details",
        "placeholder": "Street address, City, State, ZIP code"
      },
      {
        "type": "radio",
        "label": "Membership Type",
        "options": [
          "Student (Free)",
          "Adult Regular ($25/year)",
          "Senior Citizen ($15/year)",
          "Family Package ($40/year)",
          "Premium ($50/year)"
        ],
        "section": "section_membership",
        "required": true,
        "fieldName": "membership_type"
      },
      {
        "type": "dropdown",
        "label": "Membership Duration",
        "options": [
          "1 Year",
          "2 Years (10% discount)",
          "3 Years (15% discount)",
          "5 Years (20% discount)"
        ],
        "section": "section_membership",
        "required": true,
        "fieldName": "membership_duration"
      },
      {
        "type": "multiselect",
        "label": "Areas of Interest",
        "options": [
          "Fiction",
          "Science & Technology",
          "History & Biography",
          "Arts & Literature",
          "Business & Economics",
          "Health & Wellness",
          "Children's Books",
          "Digital Resources",
          "Research Materials",
          "Audiobooks",
          "Magazines & Journals"
        ],
        "section": "section_membership",
        "required": false,
        "fieldName": "special_interests",
        "maxSelections": 5
      },
      {
        "type": "calculated",
        "label": "Total Membership Fee",
        "formula": "calculateMembershipFee(membership_type, membership_duration)",
        "section": "section_membership",
        "readonly": true,
        "fieldName": "membership_fee",
        "dependencies": [
          "membership_type",
          "membership_duration"
        ]
      },
      {
        "type": "file",
        "label": "Photo ID Document",
        "maxSize": "5MB",
        "section": "section_documents",
        "tooltip": "Driver's license, passport, or government-issued ID",
        "maxFiles": 2,
        "required": true,
        "fieldName": "id_document",
        "allowedTypes": [
          ".jpg",
          ".png",
          ".pdf"
        ]
      },
      {
        "type": "file",
        "label": "Address Proof",
        "maxSize": "5MB",
        "section": "section_documents",
        "tooltip": "Utility bill, bank statement, or lease agreement",
        "maxFiles": 2,
        "required": true,
        "fieldName": "address_proof",
        "allowedTypes": [
          ".jpg",
          ".png",
          ".pdf"
        ]
      },
      {
        "type": "conditional",
        "field": {
          "type": "file",
          "maxSize": "3MB",
          "maxFiles": 1,
          "required": true,
          "allowedTypes": [
            ".jpg",
            ".png",
            ".pdf"
          ]
        },
        "label": "Student ID",
        "section": "section_documents",
        "condition": {
          "value": "Student (Free)",
          "operator": "equals",
          "fieldName": "membership_type"
        },
        "fieldName": "student_id"
      },
      {
        "type": "conditional",
        "field": {
          "type": "file",
          "maxSize": "3MB",
          "maxFiles": 1,
          "required": true,
          "allowedTypes": [
            ".jpg",
            ".png",
            ".pdf"
          ]
        },
        "label": "Senior Citizen Proof",
        "section": "section_documents",
        "condition": {
          "value": "Senior Citizen ($15/year)",
          "operator": "equals",
          "fieldName": "membership_type"
        },
        "fieldName": "senior_proof"
      },
      {
        "type": "conditional",
        "field": {
          "type": "dataGrid",
          "columns": [
            {
              "name": "full_name",
              "type": "text",
              "required": true
            },
            {
              "name": "relationship",
              "type": "dropdown",
              "options": [
                "Spouse",
                "Child",
                "Parent",
                "Sibling"
              ]
            },
            {
              "max": 120,
              "min": 0,
              "name": "age",
              "type": "number"
            }
          ],
          "maxRows": 6
        },
        "label": "Family Members Details",
        "section": "section_documents",
        "condition": {
          "value": "Family Package ($40/year)",
          "operator": "equals",
          "fieldName": "membership_type"
        },
        "fieldName": "family_members"
      },
      {
        "text": "I agree to abide by all library rules, policies, and regulations. I understand that failure to comply may result in suspension of membership privileges.",
        "type": "consent",
        "label": "Library Terms and Conditions",
        "section": "section_agreements",
        "required": true,
        "fieldName": "terms_acceptance"
      },
      {
        "text": "I consent to the collection and use of my personal information for library services and communications.",
        "type": "consent",
        "label": "Privacy Policy",
        "section": "section_agreements",
        "required": true,
        "fieldName": "privacy_consent"
      },
      {
        "type": "checkbox",
        "label": "Email Notifications",
        "options": [
          "Due date reminders",
          "New arrivals in my interests",
          "Event notifications",
          "Library announcements",
          "Overdue notices"
        ],
        "section": "section_agreements",
        "fieldName": "email_notifications"
      },
      {
        "type": "esign",
        "label": "Digital Signature",
        "section": "section_agreements",
        "required": true,
        "fieldName": "member_signature",
        "canvasWidth": 400,
        "canvasHeight": 120
      },
      {
        "type": "date",
        "label": "Registration Date",
        "section": "section_agreements",
        "readonly": true,
        "required": true,
        "fieldName": "registration_date",
        "defaultValue": "today"
      }
    ],
    "layout": {},
    "nodeId": null,
    "styling": {},
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {},
    "description": "Comprehensive member registration with document verification, fee calculation, and digital agreement",
    "data_model_id": null
  },
  {
    "id": "app_1764181570141_workflow_1703567890123_form_003",
    "name": "checkout_return_form",
    "steps": [],
    "title": null,
    "config": {},
    "fields": [
      {
        "type": "radio",
        "label": "Transaction Type",
        "options": [
          "Checkout",
          "Return",
          "Renewal",
          "Reserve"
        ],
        "section": "section_transaction",
        "required": true,
        "fieldName": "transaction_type"
      },
      {
        "type": "text",
        "label": "Transaction ID",
        "section": "section_transaction",
        "readonly": true,
        "required": false,
        "fieldName": "transaction_id",
        "defaultValue": "AUTO_GENERATED"
      },
      {
        "type": "date",
        "label": "Transaction Date",
        "section": "section_transaction",
        "required": true,
        "fieldName": "transaction_date",
        "includeTime": true,
        "defaultValue": "today"
      },
      {
        "type": "lookup",
        "label": "Librarian",
        "source": "staff_database",
        "display": "full_name",
        "section": "section_transaction",
        "required": true,
        "fieldName": "librarian_id"
      },
      {
        "type": "autocomplete",
        "label": "Member Search",
        "options": [],
        "section": "section_member",
        "minChars": 3,
        "required": true,
        "fieldName": "member_lookup",
        "placeholder": "Enter member ID, name, or email"
      },
      {
        "type": "text",
        "label": "Member ID",
        "section": "section_member",
        "readonly": true,
        "fieldName": "member_id_display"
      },
      {
        "type": "text",
        "label": "Member Name",
        "section": "section_member",
        "readonly": true,
        "fieldName": "member_name_display"
      },
      {
        "type": "text",
        "label": "Membership Status",
        "section": "section_member",
        "readonly": true,
        "fieldName": "membership_status"
      },
      {
        "type": "number",
        "label": "Current Books Checked Out",
        "section": "section_member",
        "readonly": true,
        "fieldName": "current_checkouts"
      },
      {
        "type": "currency",
        "label": "Outstanding Fines",
        "section": "section_member",
        "readonly": true,
        "fieldName": "outstanding_fines",
        "currencySymbol": "$"
      },
      {
        "type": "dataGrid",
        "label": "Books/Items",
        "columns": [
          {
            "name": "book_barcode",
            "type": "barcode",
            "label": "Scan/Enter Barcode",
            "format": "CODE128",
            "required": true
          },
          {
            "name": "book_title",
            "type": "text",
            "label": "Title",
            "readonly": true
          },
          {
            "name": "isbn",
            "type": "text",
            "label": "ISBN",
            "readonly": true
          },
          {
            "name": "due_date",
            "type": "date",
            "label": "Due Date",
            "required": true
          },
          {
            "name": "condition_out",
            "type": "rating",
            "label": "Condition (Out)",
            "maxRating": 5,
            "ratingType": "star"
          },
          {
            "name": "condition_in",
            "type": "rating",
            "label": "Condition (Return)",
            "maxRating": 5,
            "ratingType": "star"
          },
          {
            "name": "late_fee",
            "type": "currency",
            "label": "Late Fee",
            "readonly": true,
            "currencySymbol": "$"
          }
        ],
        "maxRows": 10,
        "section": "section_items",
        "required": true,
        "fieldName": "book_items"
      },
      {
        "type": "conditional",
        "field": {
          "type": "dropdown",
          "options": [
            "7 days (New releases)",
            "14 days (Regular)",
            "21 days (Academic)",
            "30 days (Reference)"
          ],
          "required": true
        },
        "label": "Checkout Duration",
        "section": "section_items",
        "condition": {
          "value": [
            "Checkout",
            "Renewal"
          ],
          "operator": "in",
          "fieldName": "transaction_type"
        },
        "fieldName": "checkout_duration"
      },
      {
        "type": "conditional",
        "field": {
          "max": 3,
          "min": 1,
          "type": "number",
          "readonly": true
        },
        "label": "Renewal Count",
        "section": "section_items",
        "condition": {
          "value": "Renewal",
          "operator": "equals",
          "fieldName": "transaction_type"
        },
        "fieldName": "renewal_count"
      },
      {
        "type": "conditional",
        "field": {
          "rows": 3,
          "type": "textarea",
          "placeholder": "Note any damage or issues"
        },
        "label": "Return Condition Notes",
        "section": "section_items",
        "condition": {
          "value": "Return",
          "operator": "equals",
          "fieldName": "transaction_type"
        },
        "fieldName": "return_condition_notes"
      },
      {
        "type": "conditional",
        "field": {
          "type": "image",
          "maxSize": "3MB",
          "maxFiles": 5
        },
        "label": "Damage Photos",
        "section": "section_items",
        "condition": {
          "value": "Return",
          "operator": "equals",
          "fieldName": "transaction_type"
        },
        "fieldName": "damage_photos"
      },
      {
        "type": "calculated",
        "label": "Total Late Fees",
        "formula": "sumColumnFromDataGrid('book_items', 'late_fee')",
        "section": "section_fees",
        "readonly": true,
        "fieldName": "late_fees_total",
        "dependencies": [
          "book_items"
        ]
      },
      {
        "type": "currency",
        "label": "Damage Fee",
        "section": "section_fees",
        "required": false,
        "fieldName": "damage_fee",
        "placeholder": "0.00",
        "currencySymbol": "$"
      },
      {
        "type": "currency",
        "label": "Processing Fee",
        "section": "section_fees",
        "required": false,
        "fieldName": "processing_fee",
        "placeholder": "0.00",
        "currencySymbol": "$"
      },
      {
        "type": "calculated",
        "label": "Total Fees Due",
        "formula": "late_fees_total + damage_fee + processing_fee",
        "section": "section_fees",
        "readonly": true,
        "fieldName": "total_fees",
        "dependencies": [
          "late_fees_total",
          "damage_fee",
          "processing_fee"
        ]
      },
      {
        "type": "conditional",
        "field": {
          "type": "radio",
          "options": [
            "Cash",
            "Credit Card",
            "Debit Card",
            "Account Credit",
            "Waived"
          ]
        },
        "label": "Payment Method",
        "section": "section_fees",
        "condition": {
          "value": 0,
          "operator": "greater_than",
          "fieldName": "total_fees"
        },
        "fieldName": "payment_method"
      },
      {
        "type": "conditional",
        "field": {
          "type": "currency",
          "required": true,
          "currencySymbol": "$"
        },
        "label": "Payment Amount",
        "section": "section_fees",
        "condition": {
          "value": 0,
          "operator": "greater_than",
          "fieldName": "total_fees"
        },
        "fieldName": "payment_amount"
      },
      {
        "type": "switch",
        "label": "Email Receipt",
