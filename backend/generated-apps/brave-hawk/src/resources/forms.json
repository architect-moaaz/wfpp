[
  {
    "id": "dispute-management-form",
    "name": "DisputeManagementForm",
    "steps": [],
    "title": "Parking Ticket Dispute Form",
    "config": {},
    "fields": [
      {
        "id": "ticket-number",
        "name": "ticketNumber",
        "type": "text",
        "label": "Ticket Number",
        "required": true,
        "validation": {
          "message": "Please enter a valid ticket number format (e.g., PT-2024-001234)",
          "pattern": "^[A-Z]{2}-\\d{4}-\\d{6}$"
        },
        "placeholder": "Enter your parking ticket number (e.g., PT-2024-001234)",
        "defaultValue": null
      },
      {
        "id": "dispute-reason",
        "name": "disputeReason",
        "type": "select",
        "label": "Reason for Dispute",
        "options": [
          "Meter was malfunctioning",
          "Valid permit was displayed",
          "Incorrect location recorded",
          "Medical emergency",
          "Signage was unclear or missing",
          "Vehicle was stolen",
          "Other"
        ],
        "required": true,
        "placeholder": "Select the primary reason for your appeal",
        "defaultValue": null
      },
      {
        "id": "dispute-details",
        "name": "disputeDetails",
        "type": "textarea",
        "label": "Detailed Explanation",
        "required": true,
        "validation": {
          "max": 2000,
          "min": 50,
          "message": "Please provide at least 50 characters explaining your dispute"
        },
        "placeholder": "Provide a detailed explanation of why you are disputing this ticket. Include dates, times, and any relevant circumstances.",
        "defaultValue": null
      },
      {
        "id": "supporting-documents",
        "name": "supportingDocuments",
        "type": "file",
        "label": "Supporting Documentation",
        "required": false,
        "validation": {
          "message": "Accepted formats: PDF, JPG, PNG. Maximum file size: 10MB"
        },
        "placeholder": "Upload photos, receipts, or other evidence (PDF, JPG, PNG - Max 10MB)",
        "defaultValue": null
      },
      {
        "id": "contact-email",
        "name": "contactEmail",
        "type": "email",
        "label": "Contact Email",
        "required": true,
        "validation": {
          "message": "Please enter a valid email address",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "placeholder": "your.email@example.com",
        "defaultValue": null
      },
      {
        "id": "contact-phone",
        "name": "contactPhone",
        "type": "text",
        "label": "Contact Phone Number",
        "required": false,
        "validation": {
          "message": "Please enter a valid phone number",
          "pattern": "^\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}$"
        },
        "placeholder": "(555) 123-4567",
        "defaultValue": null
      },
      {
        "id": "acknowledgment",
        "name": "acknowledgment",
        "type": "checkbox",
        "label": "I certify that the information provided is true and accurate to the best of my knowledge",
        "required": true,
        "validation": {
          "message": "You must acknowledge the accuracy of your submission"
        },
        "placeholder": "",
        "defaultValue": false
      }
    ],
    "layout": {
      "type": "single-column",
      "sections": [
        {
          "id": "ticket-info",
          "title": "Ticket Information",
          "fieldIds": [
            "ticket-number"
          ]
        },
        {
          "id": "dispute-details-section",
          "title": "Dispute Details",
          "fieldIds": [
            "dispute-reason",
            "dispute-details",
            "supporting-documents"
          ]
        },
        {
          "id": "contact-info",
          "title": "Contact Information",
          "fieldIds": [
            "contact-email",
            "contact-phone"
          ]
        },
        {
          "id": "certification",
          "title": "Certification",
          "fieldIds": [
            "acknowledgment"
          ]
        }
      ]
    },
    "nodeId": null,
    "styling": {},
    "formType": null,
    "metadata": {},
    "gridLayout": [],
    "validation": {
      "mode": "onSubmit",
      "showErrors": true
    },
    "description": "Submit an appeal for your parking ticket with supporting documentation and reasons",
    "data_model_id": null
  },
