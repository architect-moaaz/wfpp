[
  {
    "id": "ticketassignmentform-1765089025349-8efrhm",
    "name": "TicketAssignmentForm",
    "title": "Assign Ticket to Support Agent",
    "description": "Assign or reassign support tickets to available agents with priority adjustments and assignment notes",
    "fields": [
      {
        "id": "ticket-id",
        "name": "ticketId",
        "type": "text",
        "label": "Ticket ID",
        "placeholder": "e.g., TKT-2024-001",
        "required": true,
        "validation": {
          "pattern": "^TKT-\\d{4}-\\d{3}$",
          "message": "Please enter a valid ticket ID (e.g., TKT-2024-001)"
        },
        "defaultValue": null
      },
      {
        "id": "assigned-agent",
        "name": "assignedAgent",
        "type": "select",
        "label": "Assign to Agent",
        "placeholder": "Select an available agent",
        "required": true,
        "options": [
          "John Smith (Available)",
          "Sarah Johnson (Available)",
          "Michael Chen (Available)",
          "Emily Rodriguez (Busy - 3 tickets)",
          "David Kim (Available)"
        ],
        "defaultValue": null
      },
      {
        "id": "priority-level",
        "name": "priorityLevel",
        "type": "select",
        "label": "Priority Level",
        "placeholder": "Select priority",
        "required": true,
        "options": [
          "Critical",
          "High",
          "Medium",
          "Low"
        ],
        "defaultValue": "Medium"
      },
      {
        "id": "due-date",
        "name": "dueDate",
        "type": "date",
        "label": "Due Date",
        "placeholder": "Select due date",
        "required": false,
        "validation": {
          "min": "today",
          "message": "Due date cannot be in the past"
        },
        "defaultValue": null
      },
      {
        "id": "assignment-notes",
        "name": "assignmentNotes",
        "type": "textarea",
        "label": "Assignment Notes",
        "placeholder": "Add any relevant notes or instructions for the assigned agent...",
        "required": false,
        "validation": {
          "max": 500,
          "message": "Notes must not exceed 500 characters"
        },
        "defaultValue": null
      },
      {
        "id": "notify-agent",
        "name": "notifyAgent",
        "type": "checkbox",
        "label": "Send notification to assigned agent",
        "placeholder": "",
        "required": false,
        "defaultValue": true
      }
    ],
    "gridLayout": [
      {
        "i": "ticket-id",
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 6
      },
      {
        "i": "assigned-agent",
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 6
      },
      {
        "i": "priority-level",
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 6
      },
      {
        "i": "due-date",
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8,
        "minW": 6,
        "minH": 6
      },
      {
        "i": "assignment-notes",
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12,
        "minW": 12,
        "minH": 8
      },
      {
        "i": "notify-agent",
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8,
        "minW": 12,
        "minH": 6
      }
    ],
    "layout": {
      "type": "two-column",
      "sections": [
        {
          "id": "ticket-info",
          "title": "Ticket Information",
          "fieldIds": [
            "ticket-id",
            "assigned-agent"
          ]
        },
        {
          "id": "assignment-details",
          "title": "Assignment Details",
          "fieldIds": [
            "priority-level",
            "due-date",
            "assignment-notes"
          ]
        },
        {
          "id": "notifications",
          "title": "Notifications",
          "fieldIds": [
            "notify-agent"
          ]
        }
      ]
    },
    "submitButton": {
      "label": "Assign Ticket",
      "position": "right"
    },
    "validation": {
      "mode": "onSubmit",
      "showErrors": true
    },
    "styling": {
      "colors": {
        "primary": "#2563eb",
        "secondary": "#64748b",
        "background": "#ffffff",
        "text": "#1e293b",
        "border": "#e2e8f0"
      },
      "typography": {
        "fontFamily": "Inter, system-ui, -apple-system, sans-serif",
        "fontSize": {
          "label": "14px",
