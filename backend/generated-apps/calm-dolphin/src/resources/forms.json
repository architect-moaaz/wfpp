  {
    "id": "ticketsubmissionform-1765089060830-8u1hrb",
    "name": "TicketSubmissionForm",
    "title": "Submit Support Ticket",
    "description": "Create a new support ticket by providing details about your issue. Our team will respond as soon as possible.",
    "fields": [
      {
        "id": "ticket-title",
        "name": "title",
        "type": "text",
