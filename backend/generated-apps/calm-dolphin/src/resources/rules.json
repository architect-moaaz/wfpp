[
  {
    "id": "rule_start_validate_input",
    "name": "ValidateTicketAutoCloseInput",
    "description": "Validate that tickets exist and last activity date is present before processing auto-close workflow",
    "type": "validation",
    "priority": 0,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.id",
          "operator": "isNull",
          "value": true
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "throwError",
          "field": "workflowError",
          "value": "VALIDATION_FAILED",
          "message": "No valid ticket ID provided for auto-close workflow"
        },
        {
          "type": "logMessage",
          "field": "errorLog",
          "value": "ERROR",
          "message": "Ticket auto-close validation failed: Missing ticket identifier"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "ticket-auto-close-workflow",
    "workflowId": "ticket-auto-close-workflow",
    "application_id": "app_1765088649444"
  },
  {
    "id": "rule_decision_tickets_found",
    "name": "EvaluateTicketsForAutoClose",
    "description": "Determine if tickets are eligible for auto-close based on status and inactivity period",
    "type": "decision",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Ticket.status",
          "operator": "in",
          "value": [
            "pending",
            "waiting_customer"
          ]
        },
        {
          "field": "Ticket.lastActivityDays",
          "operator": "greaterThan",
          "value": 30
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "eligibleForAutoClose",
          "value": true,
          "message": "Ticket meets auto-close criteria"
        },
        {
          "type": "updateData",
          "field": "Ticket.status",
          "value": "auto_closed",
          "message": "Updating ticket status to auto-closed"
        },
        {
          "type": "sendNotification",
          "field": "User.email",
          "value": "TICKET_AUTO_CLOSED",
          "message": "Your ticket has been automatically closed due to 30 days of inactivity"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "ticket-auto-close-workflow",
    "workflowId": "ticket-auto-close-workflow",
    "application_id": "app_1765088649444"
  }
]