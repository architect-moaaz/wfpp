[
  {
    "id": "rule_start_archive_process",
    "name": "Start Archive Process Rule",
    "description": "Validate survey status and completion before initiating archive process",
    "type": "validation",
    "priority": 1,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.status",
          "operator": "in",
          "value": [
            "closed",
            "completed"
          ]
        },
        {
          "field": "Survey.endDate",
          "operator": "lessThan",
          "value": "{{currentDate}}"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "archiveEligible",
          "value": "true"
        },
        {
          "type": "logMessage",
          "message": "Survey validation passed - eligible for archiving"
        }
      ]
    },
    "node_id": "start-1",
    "workflow_id": "archive-survey-workflow",
    "workflowId": "archive-survey-workflow",
    "application_id": "app_1767349844748"
  },
  {
    "id": "rule_validate_survey_status",
    "name": "Validate Survey Status Rule",
    "description": "Ensure survey has no active response sessions before archiving",
    "type": "validation",
    "priority": 2,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "ResponseSession.activeCount",
          "operator": "equals",
          "value": "0"
        },
        {
          "field": "Survey.hasUnprocessedResponses",
          "operator": "equals",
          "value": "false"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "Survey.status",
          "value": "validated"
        },
        {
          "type": "setVariable",
          "field": "validationStatus",
          "value": "passed"
        }
      ]
    },
    "node_id": "validation-1",
    "workflow_id": "archive-survey-workflow",
    "workflowId": "archive-survey-workflow",
    "application_id": "app_1767349844748"
  },
  {
    "id": "rule_is_survey_eligible",
    "name": "Is Survey Eligible Rule",
    "description": "Determine if survey meets retention policy requirements for archiving",
    "type": "decision",
    "priority": 3,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "Survey.responseCount",
          "operator": "greaterThan",
          "value": "0"
        },
        {
          "field": "Survey.retentionPeriodDays",
          "operator": "greaterThan",
          "value": "30"
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "setVariable",
          "field": "workflowPath",
          "value": "proceed_to_archive"
        },
        {
          "type": "updateData",
          "field": "Survey.archiveStatus",
          "value": "eligible"
        },
        {
          "type": "logMessage",
          "message": "Survey meets eligibility criteria - proceeding to archive"
        }
      ]
    },
    "node_id": "decision-1",
    "workflow_id": "archive-survey-workflow",
    "workflowId": "archive-survey-workflow",
    "application_id": "app_1767349844748"
  },
  {
    "id": "rule_review_archive_request",
    "name": "Review Archive Request Rule",
    "description": "Validate user permissions and archive request details before approval",
    "type": "validation",
    "priority": 4,
    "is_active": true,
    "conditions": {
      "all": [
        {
          "field": "User.hasPermission",
          "operator": "equals",
          "value": "archive_survey"
        },
        {
          "field": "archiveRequest.reason",
          "operator": "notEquals",
          "value": ""
        }
      ]
    },
    "actions": {
      "actions": [
        {
          "type": "validateField",
          "field": "archiveRequest",
          "value": "approved"
        },
        {
          "type": "sendNotification",
          "field": "User.email",
          "message": "Archive request has been validated and approved for processing"
        },
        {
          "type": "setVariable",
          "field": "reviewStatus",
          "value": "approved"
        }
      ]
    },
    "node_id": "userTask-1",
    "workflow_id": "archive-survey-workflow",
    "workflowId": "archive-survey-workflow",
    "application_id": "app_1767349844748"
  }
]